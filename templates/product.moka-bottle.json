    "moka_airflow": {
      "type": "icons-with-content",
      "blocks": {
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-heading-1": {
          "type": "heading",
          "settings": {
            "title": "Air in the bottle becomes gas in your baby.",
            "title_highlight_color": "#6d388b",
            "heading_size": "h1"
          }
        },
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>A steady vent helps air move back into the bottle instead of mixing heavily into the milk.</p>",
            "text_style": "body"
          }
        },
        "moka_airflow_icon_1": {
          "type": "icon",
          "settings": {
            "icon": "child_care",
            "filled_icon": false,
            "title": "Baby drinks",
            "text": "<p>Milk moves through the nipple while pressure changes inside the bottle.</p>"
          }
        },
        "moka_airflow_icon_2": {
          "type": "icon",
          "settings": {
            "icon": "air",
            "filled_icon": false,
            "title": "Air returns above the milk",
            "text": "<p>The bottom vent sends air back into the bottle instead of through the feed.</p>"
          }
        },
        "moka_airflow_icon_3": {
          "type": "icon",
          "settings": {
            "icon": "sentiment_calm",
            "filled_icon": false,
            "title": "Calmer feeds",
            "text": "<p>Less air in the milk means a steadier bottle routine after the feed.</p>"
          }
        }
      },
      "block_order": [
