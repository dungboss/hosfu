      "blocks": {
        "moka_built_col_1": {
          "type": "column",
          "settings": {
            "image_url": "https://mokababy.co/cdn/shop/files/hf_20260618_085913_b6802063-8109-4466-b240-951891968917.jpg?v=1781773359",
            "muted_autoplay": true,
            "title": "A naturally deeper latch",
            "text": "<p>Moka uses a wide, 15° angled nipple shaped to mimic the breast, so babies who fight other bottles can latch and feed comfortably.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "moka_built_col_2": {
          "type": "column",
          "settings": {
            "image_url": "https://mokababy.co/cdn/shop/files/hf_20260602_142508_df5a3a01-e9f3-48ac-967d-b98618d7079e.jpg?v=1781685446",
            "muted_autoplay": true,
            "title": "Air stays separate from the milk",
            "text": "<p>A bottom vent returns air above the milk instead of bubbling it through, which means less swallowed air and calmer anti-colic feeds.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "moka_built_col_3": {
          "type": "column",
          "settings": {
            "image_url": "https://mokababy.co/cdn/shop/files/hf_20260617_092237_87fa0846-b900-4b5d-9302-cebeec63abdb.png?v=1781690715",
            "muted_autoplay": true,
            "title": "Glass, not warm plastic",
            "text": "<p>Milk sits in high-borosilicate glass, never a plastic body, so you always know what's touching your baby's feed.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "moka_built_col_4": {
          "type": "column",
          "settings": {
