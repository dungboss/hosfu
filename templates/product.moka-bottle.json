    "moka_care": {
      "type": "icons-with-content",
      "blocks": {
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-heading-1": {
          "type": "heading",
          "settings": {
            "title": "Simple enough for 3 a.m.",
            "title_highlight_color": "#6d388b",
            "heading_size": "h1"
          }
        },
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>A note on care. Moka is safe to boil, steam, and UV-sterilize. The silicone and PPSU parts last longer if you hand-wash them and save sterilizing for when you need it. The glass can take the heat any day.</p>",
            "text_style": "body"
          }
        },
        "moka_care_icon_1": {
          "type": "icon",
          "settings": {
            "icon": "format_color_fill",
            "filled_icon": false,
            "title": "Fill",
            "text": "<p>Clear, readable markings.</p>"
          }
        },
        "moka_care_icon_2": {
          "type": "icon",
          "settings": {
            "icon": "local_drink",
            "filled_icon": false,
            "title": "Feed",
            "text": "<p>Breast-shaped, leak-free.</p>"
          }
        },
        "moka_care_icon_3": {
          "type": "icon",
          "settings": {
            "icon": "cleaning_services",
            "filled_icon": false,
            "title": "Rinse",
            "text": "<p>Four parts, no tubes.</p>"
          }
        },
        "moka_care_icon_4": {
