            "muted_autoplay": true,
            "title": "Four parts, leak-free",
            "text": "<p>No tubes or tiny valves to lose or scrub, and a leak-free seal that survives the bottom of a bag.</p>",
            "link_label": "",
            "link": ""
          }
        }
