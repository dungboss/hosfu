    "moka_flow": {
      "type": "icons-with-content",
      "blocks": {
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-heading-1": {
          "type": "heading",
          "settings": {
            "title": "The right flow for every stage.",
            "title_highlight_color": "#6d388b",
            "heading_size": "h1"
          }
        },
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>Five laser-cut silicone nipples give a precise, consistent flow at every age, from a slow newborn flow to a faster flow for hungry toddlers. Lactation-consultant approved.</p>",
            "text_style": "body"
          }
        },
        "moka_flow_icon_1": {
          "type": "icon",
          "settings": {
            "icon": "touch_app",
            "filled_icon": false,
            "title": "Start with your baby's age",
            "text": "<p>SS (0–1m), S (1–3m), M (3–6m), L (6–10m), or LL (10m+). Breastfed babies often do best one stage slower.</p>"
          }
        },
        "moka_flow_icon_2": {
          "type": "icon",
          "settings": {
            "icon": "south_west",
            "filled_icon": false,
            "title": "Slow down if you see gulping",
            "text": "<p>Coughing, milk escaping the mouth, pulling off, or fussing can mean the flow is too fast.</p>"
          }
        },
        "moka_flow_icon_3": {
          "type": "icon",
          "settings": {
            "icon": "north_east",
            "filled_icon": false,
            "title": "Speed up if feeds drag on",
            "text": "<p>Long feeds, frustration at the nipple, chewing, or falling asleep before finishing can mean the flow is too slow.</p>"
          }
        }
      },
