    "moka_materials": {
      "type": "icons-with-content",
      "blocks": {
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-heading-1": {
          "type": "heading",
          "settings": {
            "title": "Swiss-engineered. Safe down to the last part.",
            "title_highlight_color": "#6d388b",
            "heading_size": "h1"
          }
        },
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>Most bottles tell you what they're free of. We'll tell you exactly what your baby's milk touches, and why we chose every material.</p>",
            "text_style": "body"
          }
        },
        "moka_materials_icon_1": {
          "type": "icon",
          "settings": {
            "icon": "opacity",
            "filled_icon": false,
            "title": "High-borosilicate glass",
            "text": "<p>Milk sits in glass, never plastic. It handles 180°C and the temperature swings of a bottle warmer without clouding, scratching, or cracking like ordinary glass.</p>"
          }
        },
        "moka_materials_icon_2": {
          "type": "icon",
          "settings": {
            "icon": "water_drop",
            "filled_icon": false,
            "title": "Platinum-cured silicone nipple",
            "text": "<p>Not standard food-grade silicone. Platinum curing leaves no chemical byproducts, so the nipple is purer, softer, more heat-stable, and longer-lasting.</p>"
          }
        },
        "moka_materials_icon_3": {
          "type": "icon",
          "settings": {
            "icon": "category",
            "filled_icon": false,
            "title": "BPA-free PPSU cap & ring",
            "text": "<p>The same high-performance polymer used in medical devices. It takes repeated sterilizing without warping where ordinary polypropylene can degrade.</p>"
          }
        },
        "moka_materials_icon_4": {
          "type": "icon",
          "settings": {
            "icon": "verified",
            "filled_icon": false,
            "title": "Lead-free",
            "text": "<p>Independently third-party tested and confirmed lead-free.</p>"
          }
        }
      },
      "block_order": [
        "template--21507361800487__4fc05ee5-1c30-4863-b88f-81cb6fa7c41a-heading-1",
