    "moka_built": {
      "type": "multicolumn",
      "blocks": {
        "moka_built_col_1": {
          "type": "column",
          "settings": {
            "image_url": "",
            "image": "shopify://shop_images/ChatGPT_Image_Jul_10_2026_09_25_59_AM.png",
            "muted_autoplay": true,
            "title": "Designed for a more natural latch",
            "text": "<p>Hosfu’s wide, 15° angled nipple is shaped to closely resemble the breast, helping babies latch more easily and enjoy a smoother, more comfortable feeding experience.<br/><br/></p>",
            "link_label": "",
            "link": ""
          }
        },
        "moka_built_col_2": {
          "type": "column",
          "settings": {
            "image_url": "",
            "image": "shopify://shop_images/ChatGPT_Image_Jul_10_2026_09_29_32_AM.png",
            "muted_autoplay": true,
            "title": "Keeps air above the milk",
            "text": "<p>The bottom vent allows air to return to the space above the milk instead of bubbling through it, helping babies swallow less air during feeding.<br/><br/></p>",
            "link_label": "",
            "link": ""
          }
        },
        "moka_built_col_3": {
          "type": "column",
          "settings": {
            "image_url": "",
            "image": "shopify://shop_images/ChatGPT_Image_Jul_10_2026_09_42_24_AM.png",
            "muted_autoplay": true,
            "title": "Milk touches glass, not plastic",
            "text": "<p>Hosfu uses high-borosilicate glass for the bottle body, so your baby’s milk never sits against warm plastic.<br/><br/></p>",
            "link_label": "",
            "link": ""
          }
        },
        "moka_built_col_4": {
          "type": "column",
          "settings": {
            "image_url": "",
            "image": "shopify://shop_images/ChatGPT_Image_Jul_10_2026_09_38_26_AM.png",
            "muted_autoplay": true,
            "title": "Simple parts, secure seal",
            "text": "<p>With only four easy-to-clean components and no tiny valves or complicated tubes, Hosfu is designed for quick assembly and reliable leak protection.<br/><br/></p>",
            "link_label": "",
            "link": ""
          }
        }
      },
