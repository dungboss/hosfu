    "progressive-resistance-intro": {
      "type": "rich-text",
      "blocks": {
        "heading_12l": {
          "type": "heading",
          "settings": {
            "title": "12 Levels. One Trainer. For Life.",
            "heading_size": "h1",
            "alignment": "left",
            "mobile_alignment": "mobile-left",
            "margin_top": 15,
            "margin_bottom": 15
          }
        },
        "text_12l_1": {
          "type": "text",
          "settings": {
            "text": "<p>The biggest complaint about other arm wrestling trainers? They hit the ceiling too fast. One guy on Reddit summed it up perfectly: <em>\"Got strong enough in two weeks and there was nowhere to go.\"</em></p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 15,
            "margin_bottom": 15
          }
        },
        "text_12l_2": {
          "type": "text",
          "settings": {
            "text": "<p>We fixed that. With 12 distinct resistance settings — from light rehabilitation work all the way up to \"genuinely challenging for a seasoned gym-goer\" — this trainer grows with you. Pull the handle outward, shift the gear, and you're training at the next level. Simple.</p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 15,
            "margin_bottom": 15
          }
        }
      },
      "block_order": [
        "heading_12l",
        "text_12l_1",
        "text_12l_2"
      ],
