round: #2bc4b5; transform: translateY(-1px); }\n  .cta-order-secure { font-size: 0.6875rem; color: #9ca3af; }\n</style>\n<div class=\"cta-order\" id=\"order-form\">\n  <div class=\"cta-order-box\">\n    <div class=\"cta-order-inner\">\n      <span class=\"cta-order-badge\">EXCLUSIVE TODAY ONLY OFFER</span>\n      <h3 class=\"cta-order-heading\">CLAIM YOUR PELVIDEX&trade;</h3>\n      <p class=\"cta-order-desc\">Order now to save 50% on your PelviDex&trade; Trainer with free worldwide shipping, backed by our 30-day risk-free guarantee.</p>\n      <div>\n        <div class=\"cta-order-price\">$99.00 <span class=\"cta-order-price-original\">$198.00</span></div>\n        <p class=\"cta-order-warranty\">&#x2714; Includes 12-Month Hassle-Free Warranty</p>\n      </div>\n      <a href=\"/products/pelvidex\" class=\"cta-order-btn\">Order Now - Get 50% Off</a>\n      <p class=\"cta-order-secure\">100% Secure Checkout &mdash; Discretely Packaged &amp; Shipped</p>\n    </div>\n  </div>\n</div>",
