      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .cb2-section { padding: 4rem 1rem; background: #eaf6f4; border-bottom: 1px solid #e5e7eb; }\n  @media (min-width: 768px) { .cb2-section { padding: 6rem 1rem; } }\n  .cb2-inner { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 6rem; }\n  @media (min-width: 768px) { .cb2-inner { gap: 8rem; } }\n  .cb2-row { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }\n  @media (min-width: 768px) { .cb2-row { grid-template-columns: 7fr 5fr; } }\n  .cb2-content { display: flex; flex-direction: column; gap: 1.5rem; }\n  .cb2-heading { font-family: 'Montserrat', sans-serif; font-size: 1.75rem; font-weight: 800; color: #111827; line-height: 1.2; margin: 0; }\n  @media (min-width: 768px) { .cb2-heading { font-size: 2.25rem; } }\n  .cb2-text { font-size: 1rem; line-height: 1.75; color: #374151; margin: 0; }\n  @media (min-width: 768px) { .cb2-text { font-size: 1.125rem; } }\n  .cb2-text strong { color: #111827; font-weight: 700; }\n  .cb2-text .highlight { color: #e27243; font-weight: 700; }\n  .cb2-image-box { display: flex; justify-content: center; }\n  .cb2-image-mock { width: 100%; max-width: 360px; aspect-ratio: 1; border-radius: 1rem; overflow: hidden; border: 4px solid #fff; padding: 1.5rem; position: relative; display: flex; flex-direction: column; box-shadow: 0 20px 50px -12px rgba(0,0,0,0.25); }\n  .cb2-image-mock-teal { background: linear-gradient(to bottom, #f0fdfa, #d1fae5); }\n  .cb2-image-mock-red { background: linear-gradient(to bottom, #fef2f2, #fffbeb); }\n  .cb2-image-badge { position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); padding: 6px 16px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-align: center; white-space: nowrap; }\n  .cb2-image-badge-teal { background: #115e59; color: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }\n  .cb2-image-badge-red { background: #dc2626; color: #fff; left: 0; right: 0; bottom: 0; border-radius: 0 0 0.75rem 0.75rem; padding: 8px 16px; width: 100%; transform: none; font-size: 0.75rem; }\n  .cb2-cta { display: inline-flex; align-items: center; justify-content: center; background: #3bd9ca; color: #000; font-weight: 800; padding: 0.9rem 1.75rem; border-radius: 12px; border-bottom: 4px solid #259b90; text-decoration: none; font-size: 1rem; transition: all 0.3s; }\n  @media (min-width: 768px) { .cb2-cta { font-size: 1.125rem; } }\n  .cb2-cta:hover { background: #2bc4b5; transform: translateY(-1px); }\n  .cb2-cta-arrow { width: 20px; height: 20px; margin-left: 10px; animation: cb2-pulse 2s infinite; }\n  @keyframes cb2-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }\n  .cb2-italic { font-style: italic; color: #6b7280; }\n  .cb2-strong-red { color: #dc2626; font-weight: 700; }\n  .cb2-strong-emerald { color: #047857; font-weight: 700; }\n</style>\n<div class=\"cb2-section\">\n  <div class=\"cb2-inner\">\n    <div class=\"cb2-row\">\n      <div class=\"cb2-content\">\n        <h2 class=\"cb2-heading\">Designed by Experts in Men's Pelvic Health</h2>\n        <p class=\"cb2-text\">The PelviDex&trade; is <strong>backed by research</strong> in pelvic floor therapy and muscle activation.</p>\n        <p class=\"cb2-text\">It also comes with a <strong>free Kegel eBook and video course</strong>, designed by experts to help you track your progress and maximize results.</p>\n        <p class=\"cb2-text\">For less than the cost of pads or expensive procedures you can <strong>regain confidence with a proven, at-home solution</strong>.</p>\n      </div>\n      <div class=\"cb2-image-box\">\n        <div class=\"cb2-image-mock cb2-image-mock-teal\">\n          <div style=\"display:flex;align-items:center;justify-content:center;height:100%;\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"1\" style=\"width:180px;height:180px;\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"#fff\" opacity=\"0.6\"/>\n              <path d=\"M4 21c0-3.5 2.5-5.5 6-6h4c3.5.5 6 2.5 6 6\" fill=\"#f8fafc\" stroke=\"#475569\" stroke-width=\"1.2\"/>\n              <path d=\"M10 15v3.5l2 1.5 2-1.5V15\" fill=\"#3b82f6\" stroke=\"#1d4ed8\" stroke-width=\"1\"/>\n              <circle cx=\"12\" cy=\"9\" r=\"3.5\" fill=\"#fbcfe8\" stroke=\"#db2777\" stroke-width=\"1\"/>\n              <path d=\"M8.5 9c-.2-2.5 1.5-4 3.5-4s3.7 1.5 3.5 4\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            </svg>\n          </div>\n          <div class=\"cb2-image-badge cb2-image-badge-teal\">Medical Advisory Board</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"cb2-row\">\n      <div class=\"cb2-content\">\n        <h2 class=\"cb2-heading\">The Longer You Wait, the Worse It Gets</h2>\n        <p class=\"cb2-text\">Men who leak urine are more likely to <strong>fall &mdash; especially at night</strong>.</p>\n        <p class=\"cb2-text\">Getting up to rush to the bathroom in the dark can be risky.</p>\n        <p class=\"cb2-text\">One small trip could cause a <strong class=\"cb2-strong-red\">bad injury</strong> and take away your <strong>freedom</strong>.</p>\n        <p class=\"cb2-text cb2-italic\">But that's not all.</p>\n        <p class=\"cb2-text\"><strong>Weak pelvic muscles don't just cause leaks.</strong></p>\n        <p class=\"cb2-text\">They can also lead to other health problems &mdash; like <strong>pressure on the prostate</strong> or even organs shifting out of place.</p>\n        <p class=\"cb2-text\">And the longer you wait, the <strong class=\"cb2-strong-red\">weaker</strong> those muscles get.</p>\n        <p class=\"cb2-text\">That means it gets <strong>harder to fix</strong> later.</p>\n        <p class=\"cb2-text\">But you don't have to wait.</p>\n        <p class=\"cb2-text\"><strong class=\"cb2-strong-emerald\">The PelviDex&trade; helps you start now.</strong></p>\n        <p class=\"cb2-text\">Use it just <strong class=\"highlight\">5 minutes a day</strong> to build strength, stop leaks, and take back control.</p>\n        <div style=\"padding-top:1rem;\">\n          <a href=\"#order-form\" class=\"cb2-cta\">\n            Get 50% off today only\n            <svg class=\"cb2-cta-arrow\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3\"/></svg>\n          </a>\n        </div>\n      </div>\n      <div class=\"cb2-image-box\">\n        <div class=\"cb2-image-mock cb2-image-mock-red\">\n          <div style=\"position:absolute;inset:0;opacity:0.1;background-image:radial-gradient(#1e293b 1px,transparent 1px);background-size:16px 16px;z-index:0;\"></div>\n          <div style=\"position:relative;z-index:10;display:flex;align-items:center;justify-content:center;height:100%;\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"1\" style=\"width:150px;height:150px;\">\n              <rect x=\"3\" y=\"11\" width=\"18\" height=\"5\" rx=\"1.5\" fill=\"#fef3c7\" stroke=\"#b45309\" stroke-width=\"1\"/>\n              <path d=\"M12 16v5M10 21h4\" stroke=\"#475569\" stroke-width=\"1.5\"/>\n              <circle cx=\"12\" cy=\"10.5\" r=\"2\" fill=\"#fed7aa\" stroke=\"#c2410c\"/>\n              <ellipse cx=\"12\" cy=\"15.5\" rx=\"3.5\" ry=\"1.5\" fill=\"#3b82f6\" opacity=\"0.6\"/>\n            </svg>\n          </div>\n          <div class=\"cb2-image-badge cb2-image-badge-red\">Nighttime Fall Risk Active</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
