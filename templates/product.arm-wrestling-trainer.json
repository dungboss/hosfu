    "real_words_section": {
      "type": "facebook-testimonials",
      "blocks": {
        "column_WYqrYL": {
          "type": "column",
          "settings": {
            "post_author": "Aaron C.",
            "post_author_avatar": "",
            "post_author_verified": false,
            "post_time": "2h ago",
            "post_text": "<p>I wanted a compact trainer for grip and forearm work without buying a whole cable setup. This has been pretty effective. The beechwood feels solid — not the cheap plastic-y vibe I was half-expecting at this price point. Stays put on my desk without wandering around during reps. Does exactly what I wanted it to do.</p>",
            "post_image": "",
            "post_reactions": "like, love, care",
