            "post_author_verified": false,
            "post_time": "1 day ago",
            "post_text": "<p>I wanted something more targeted than a generic forearm roller. This is it. Compact enough to keep on the kitchen counter without it being in the way. The resistance system genuinely feels different from standard gym movements — I can feel it targeting muscles I wasn’t hitting before.</p>",
            "post_image": "",
            "post_reactions": "like, love, care",
            "post_reactions_text": "1.1k",
