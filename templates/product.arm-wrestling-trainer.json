            "post_author_avatar": "",
            "post_author_verified": true,
            "post_time": "2 weeks ago",
            "post_text": "<p>I had tried on-and-off grip training before, but this felt simple enough to actually keep using. It fits perfectly into my daily routine. The 12 resistance levels keep me motivated to push harder every week.</p>",
            "post_image": "",
            "post_reactions": "like, love, care",
