            "comment_2_time": "3h ago",
            "comment_2_text": ""
          }
        },
        "column_cFizfx": {
          "type": "column",
          "settings": {
            "post_author": "Michael R.",
            "post_author_avatar": "shopify://shop_images/t_i_xu_ng.jpg",
            "post_author_verified": false,
            "post_time": "5h ago",
            "post_text": "<p>I’m 48, married, with two kids and an aging father who still insists he’s fine to drive after a couple drinks. I bought <strong>HOSFU</strong> for our house after a friend got a DUI coming home from a dinner party. Now we use it before anyone gets behind the wheel after wine, BBQs, or weekend gatherings. It takes seconds, and it ends the argument. No more “I think I’m okay.” There’s a number on the screen. I ended up buying a second one for my dad’s car.</p>",
            "post_image": "shopify://shop_images/3_eb06c66b-01ed-4475-99d1-bf2a71538030.png",
            "post_reactions": "like, love, care",
            "post_reactions_text": "658",
            "post_comments_text": "46 Comments",
            "comment_1_author": "Comment author",
            "comment_1_author_verified": false,
            "comment_1_time": "2h ago",
            "comment_1_text": "",
            "comment_2_author": "Comment author",
