        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "I've tried Kegels before. How is this different?",
            "answer": "Most women don't need more reminders. They need a routine that feels easier to repeat. [product_title] is designed to make the habit feel more approachable, structured, and realistic at home.",
            "open_by_default": false
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Is this a medical treatment?",
            "answer": "No. This is an at-home wellness routine meant to support consistency and comfort. It is not a substitute for medical diagnosis or treatment. If you have specific concerns, speak with a qualified clinician.",
            "open_by_default": false
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it after childbirth?",
            "answer": "Many women look for pelvic floor support after childbirth, but recovery is personal. If you're postpartum, we recommend following your provider's guidance on when to begin any new routine.",
            "open_by_default": false
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "How often should I use it?",
            "answer": "The strongest results usually come from consistency, not marathon sessions. A simple, repeatable 20-minute rhythm tends to be easier to maintain than an all-or-nothing plan.",
            "open_by_default": false
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Will it be discreet?",
            "answer": "Yes. The routine is designed for private, at-home use, and orders are shipped discreetly so you can start without extra friction.",
            "open_by_default": false
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "What if I've felt disconnected from this area for years?",
            "answer": "That's exactly why consistency-first routines matter. Many women aren't starting from a lack of effort. They're starting from a lack of clarity, structure, and support.",
            "open_by_default": false
          }
        },
        "faq_7": {
          "type": "faq_item",
          "settings": {
            "question": "Is [product_title] hard to fit into a busy schedule?",
            "answer": "It shouldn't be. The routine is built around short, manageable sessions so you can fit it into mornings, evenings, or any reset window that already exists in your day.",
            "open_by_default": false
          }
        },
        "faq_8": {
          "type": "faq_item",
          "settings": {
            "question": "What if it doesn't feel like the right fit for me?",
            "answer": "Start with the promise that you're simply testing consistency, not chasing perfection. If it doesn't feel aligned with your routine, you have a 30-day confidence promise to lean on.",
            "open_by_default": false
          }
        },
