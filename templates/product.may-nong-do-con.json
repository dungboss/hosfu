    "real_words_section": {
      "type": "facebook-testimonials",
      "blocks": {
        "column_WYqrYL": {
          "type": "column",
          "settings": {
            "post_author": "Nat Thomas",
            "post_author_avatar": "shopify://shop_images/Screenshot_2026-05-11_101458.png",
            "post_author_verified": false,
            "post_time": "2h ago",
            "post_text": "<p>The best investment I've made for my safety this year. I used to just guess how I felt after a couple of beers, but having actual, accurate numbers stopped me from driving home last weekend when I thought I was 'fine.' Thank you, HOSFU!</p>",
            "post_image": "shopify://shop_images/Untitled_image_14.png",
            "post_reactions": "like, love, care",
