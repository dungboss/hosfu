            "open_state_row_icon": "#1a237e",
            "open_state_collapse_icon": "#1a237e",
            "open_state_collapse_icon_solid": "#ffffff",
            "open_state_collapse_bg": "#1a237e",
            "open_state_content_bg": "#fefaff",
            "open_state_content_text": "#121212",
            "content": "<p>Hosfu utilizes advanced, <strong>police-grade precision electrochemical sensors</strong>. Unlike cheap semiconductor breathalyzers that can be tricked by breath mints, keto diets, or acetone, our technology specifically isolates alcohol. This ensures you get a highly accurate Blood Alcohol Concentration (BAC) reading starting from 0.000%. It’s independently calibrated to deliver undeniable proof you can trust, every single time.</p>",
            "page": "",
            "margin_top": 0,
            "margin_bottom": 0
          },
          "blocks": {}
        },
        "desc_row_2": {
          "type": "collapsible-row",
          "settings": {
            "open": false,
            "heading": "How To Use",
            "heading_size": "medium",
            "icon": "",
            "filled_icon": false,
            "collapse_icon": "carret",
            "collapse_icon_style": "standard",
