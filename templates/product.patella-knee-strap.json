    "collapsible_content_nJrYmE": {
      "type": "collapsible-content",
      "blocks": {
        "faq_1": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "How is this different from a regular knee wrap?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Patella Knee Strap uses focused compression below the kneecap to help it stay centered and provide a steadier feel than a loose wrap.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "faq_2": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Is this a medical treatment?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Patella Knee Strap is a support accessory designed for comfort and stability. It is not medical treatment. If you have persistent pain, swelling, or a recent injury, consult a qualified clinician before use.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "faq_3": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Who is this strap designed for?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>It’s designed for people who want extra knee support while walking, training, hiking, climbing stairs, or spending long days on their feet.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "faq_4": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "How often should I use it?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Use it whenever you want extra support. Many people wear it during activity or any time the knee needs a steadier feeling.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "faq_5": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Is it adjustable?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Yes. The strap is designed to be adjusted quickly so you can find a secure but comfortable fit.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "faq_6": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "Will it be discreet?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Absolutely. The low-profile strap is made to fit under clothing without feeling bulky, and orders ship in plain packaging.</p>",
            "page": ""
          },
          "blocks": {}
        },
        "faq_7": {
          "type": "collapsible-row-content",
          "settings": {
            "open": false,
            "heading": "What if it does not feel like the right fit for me?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>It includes a <strong>30-Day Money-Back Guarantee</strong>. If it isn't the right fit, contact support for a hassle-free return.</p>",
            "page": ""
          },
          "blocks": {}
        }
      },
