      "blocks": {
        "column_WYqrYL": {
          "type": "column",
          "settings": {
            "post_author": "Emma W.",
            "post_author_avatar": "shopify://shop_images/Gemini_Generated_Image_6a70ma6a70ma6a70.png",
            "post_author_verified": false,
            "post_time": "2h ago",
            "post_text": "<p>The best investment I've made for my home's safety this year. We use a gas boiler, and I always worried about silent leaks. I'm finally getting a full night's sleep again knowing this detector is monitoring the air 24/7. Highly recommend!</p>",
            "post_image": "shopify://shop_images/3D5F7ABB-DEE1-49EF-8452-203B6807E5D0_1_201_a.jpg",
            "post_reactions": "like, love, care",
            "post_reactions_text": "2.3k",
            "post_comments_text": "65 Comments",
            "comment_1_author": "Comment author",
            "comment_1_author_verified": false,
            "comment_1_time": "2h ago",
            "comment_1_text": "",
            "comment_2_author": "Comment author",
