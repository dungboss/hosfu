    "real_words_section": {
      "type": "facebook-testimonials",
      "blocks": {
        "column_WYqrYL": {
          "type": "column",
          "settings": {
            "post_author": "Emma W.",
            "post_author_avatar": "shopify://shop_images/Gemini_Generated_Image_6a70ma6a70ma6a70.png",
            "post_author_verified": false,
            "post_time": "2h ago",
            "post_text": "<p>The best investment I've made for my family's safety this year. We lost power during a recent storm, and having the hand-crank radio and emergency flashlight gave us so much peace of mind. I'm finally feeling fully prepared for the unexpected. Thank you, Hosfu!</p>",
            "post_image": "shopify://shop_images/3E587E30-D153-4CD2-B736-739C497855CB.png",
            "post_reactions": "like, love, care",
            "post_reactions_text": "2.3k",
            "post_comments_text": "65 Comments",
            "comment_1_author": "Comment author",
            "comment_1_author_verified": false,
            "comment_1_time": "2h ago",
            "comment_1_text": "",
            "comment_2_author": "Comment author",
