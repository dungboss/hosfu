        "column_cFizfx": {
          "type": "column",
          "settings": {
            "post_author": "Sophie L.",
            "post_author_avatar": "shopify://shop_images/Phu-Nu-Trung-Nien.jpg",
            "post_author_verified": false,
            "post_time": "5h ago",
            "post_text": "<p>I had tried relying on solar chargers and bulky power banks before, but they always died when I actually needed them. This tool is simple and reliable. It fits perfectly into my camping backpack without weighing it down. The hand-crank feature keeps me confident that I'll never be completely off-grid.</p>",
            "post_image": "shopify://shop_images/0D4D5B58-F78E-426A-BCC3-BCF3E6939D69.jpg",
            "post_reactions": "like, love, care",
            "post_reactions_text": "658",
            "post_comments_text": "46 Comments",
            "comment_1_author": "Comment author",
            "comment_1_author_verified": false,
            "comment_1_time": "2h ago",
            "comment_1_text": "",
            "comment_2_author": "Comment author",
            "comment_2_author_verified": false,
            "comment_2_time": "3h ago",
