    "rich_text_4nN4k3": {
      "type": "rich-text",
      "blocks": {
        "text_MYJUhd": {
          "type": "text",
          "name": "Text",
          "settings": {
            "text": "<p>HOSFU was <strong>invented and developed</strong> by first responders who saw the same tragedy repeat itself every winter — families with basic, \"working\" alarms that never gave them the early warning they desperately needed. </p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 15,
            "margin_bottom": 15
          },
          "blocks": {}
        },
        "text_TDCeNb": {
          "type": "text",
          "name": "Text",
          "settings": {
            "text": "<p><strong>✓ CE Certified</strong> — Meets the strictest safety, health, and environmental protection requirements for European homes.<br/></p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 0,
            "margin_bottom": 0
          },
          "blocks": {}
        },
        "text_nqHmD4": {
          "type": "text",
          "name": "Text",
          "settings": {
            "text": "<p><strong>✓ Professional-Grade Sensors</strong> — Powered by highly accurate electrochemical technology to detect threats instantly.<br/></p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 0,
            "margin_bottom": 0
          },
          "blocks": {}
        },
        "text_dPfdec": {
          "type": "text",
          "name": "Text",
          "settings": {
            "text": "<p><strong>✓ 4-in-1 Real-Time Tracking</strong> — Independently tested to monitor Carbon Monoxide, Natural Gas, Temperature, and Humidity.</p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 0,
            "margin_bottom": 15
          },
          "blocks": {}
        },
        "text_LfwUxh": {
          "type": "text",
          "name": "Text",
          "settings": {
            "text": "<p>HOSFU isn't just another basic, blinking detector. It's the advanced early-warning system that rescue professionals wish every family had.</p><p><strong>Like having a 24/7 safety inspector plugged into your wall — constantly monitoring your air so you don't have to.</strong></p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 12,
