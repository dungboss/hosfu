        "column_WCRMNm": {
          "type": "column",
          "settings": {
            "post_author": "Anna K.",
            "post_author_verified": false,
            "post_time": "1 day ago",
            "post_text": "<p>I was skeptical at first, but the quality of this detector is impressive. The build is solid and the setup was a breeze—literally just plug it into the wall outlet. Already feeling much more 'in control' of my home's safety after just a few days. Highly recommend for anyone on the fence!</p>",
            "post_image": "shopify://shop_images/60FBACC1-09CD-4895-9DA8-F71C3B2E20B4.jpg",
            "post_reactions": "like, love, care",
            "post_reactions_text": "1.1k",
            "post_comments_text": "26 Comments",
            "comment_1_author": "Comment author",
            "comment_1_author_verified": false,
