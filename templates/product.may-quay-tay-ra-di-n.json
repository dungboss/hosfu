        "text_FkUwBU": {
          "type": "text",
          "settings": {
            "text": "<p>A brilliantly designed 4-in-1 device that continuously monitors your home's air. It tracks Carbon Monoxide and Natural Gas in real-time, while keeping you beautifully informed of your room’s temperature and humidity at a single glance.</p><p> We believe home security shouldn't be complicated. Just plug HOSFU directly into any standard outlet. No messy wires, no complicated setups, and no drilling required. You get instant, reliable protection from the moment it powers on. <strong>Breathe easier. Sleep better. HOSFU watches over your home so you don't have to.</strong></p>",
            "alignment": "left",
            "mobile_alignment": "mobile-center",
            "text_size": 16,
            "enable_custom_color": false,
            "custom_text_color": "#ff0000",
            "margin_top": 6,
            "margin_bottom": 6
          },
          "blocks": {}
        },
