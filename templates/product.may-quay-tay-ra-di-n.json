        "column_cFizfx": {
          "type": "column",
          "settings": {
            "post_author": "Sophie L.",
            "post_author_avatar": "shopify://shop_images/Phu-Nu-Trung-Nien.jpg",
            "post_author_verified": false,
            "post_time": "5h ago",
            "post_text": "<p>I had tried traditional battery alarms before, but this plug-in design is so simple. You literally just plug it into the wall and it works. The real-time digital screen showing the exact gas levels gives me so much more confidence than a basic flashing light.</p>",
            "post_image": "shopify://shop_images/Gemini_Generated_Image__-_2026-06-01T165201.681.png",
            "post_reactions": "like, love, care",
            "post_reactions_text": "658",
            "post_comments_text": "46 Comments",
            "comment_1_author": "Comment author",
            "comment_1_author_verified": false,
