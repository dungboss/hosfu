          "type": "column",
          "settings": {
            "post_author": "Sarah J.",
            "post_author_avatar": "shopify://shop_images/Gemini_Generated_Image_jktpo0jktpo0jktp.png",
            "post_author_verified": true,
            "post_time": "1 month ago",
            "post_text": "<p>This is so much better than trying to guess what a blinking light means on a standard alarm. The real-time display actually shows you the exact gas and CO levels in the room. It’s simple, highly effective, and the digital numbers are very easy to read even for someone my age.</p>",
            "post_image": "shopify://shop_images/7007CAF8-423F-4764-AF03-6DE4204D6048_1_201_a.jpg",
