        "review_1": {
          "type": "column",
          "settings": {
            "post_author": "Jackson R.",
            "post_author_avatar": "shopify://shop_images/b27a418cf6849a21dfba046d8db11c34.jpg",
            "post_author_verified": true,
            "post_time": "2 weeks ago",
            "post_text": "<p>Fast shipping and arrived exactly as promised. The unboxing experience was great, and the device is very unobtrusive. I have it plugged in near my gas boiler and it monitors the air 24/7 without any hassle. Finally, a plug-and-play safety solution that makes sense.</p>",
            "post_image": "shopify://shop_images/5FED19FF-35A7-4E13-B2F3-2BB22B3F5011.jpg",
            "post_reactions": "like, love, care",
            "post_reactions_text": "148",
