<style>
  .expert-quote-{{ block.id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;
    margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;
  }
  .expert-quote-{{ block.id }} .expert-quote__image {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_width }}px;
    overflow: hidden;
  }
  .expert-quote-{{ block.id }} .expert-quote__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .expert-quote-{{ block.id }} .expert-quote__content {
    flex: 1;
    min-width: 0;
  }
  .expert-quote-{{ block.id }} .expert-quote__text {
    font-size: {{ block.settings.quote_size | divided_by: 10.0 }}rem;
    color: {{ block.settings.quote_color }};
    line-height: 1.5;
  }
  .expert-quote-{{ block.id }} .expert-quote__attribution {
    font-size: {{ block.settings.attribution_size | divided_by: 10.0 }}rem;
    color: {{ block.settings.attribution_color }};
    margin-top: 6px;
  }
</style>

<div class="expert-quote-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image_url != blank %}
    <div class="expert-quote__image">
      <img
        src="{{ block.settings.image_url }}"
        alt="{{ block.settings.attribution | escape }}"
        width="{{ block.settings.image_width }}"
        height="{{ block.settings.image_width }}"
        loading="lazy"
      >
    </div>
  {% endif %}
  <div class="expert-quote__content">
    {% if block.settings.quote != blank %}
      <div class="expert-quote__text rte">
        {{ block.settings.quote }}
      </div>
    {% endif %}
    {% if block.settings.attribution != blank %}
      <div class="expert-quote__attribution">
        <strong>{{ block.settings.attribution | escape }}</strong>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Expert Quote",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "External image URL for the expert photo"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 40,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "Image size"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "default": "<p>\"Enter the expert quote here.\"</p>"
    },
    {
      "type": "range",
      "id": "quote_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15,
      "label": "Quote text size"
    },
    {
      "type": "color",
      "id": "quote_color",
      "default": "#121212",
      "label": "Quote text color"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "Name, Title"
    },
    {
      "type": "range",
      "id": "attribution_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "Attribution text size"
    },
    {
      "type": "color",
      "id": "attribution_color",
      "default": "#121212",
      "label": "Attribution text color"
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 60,
      "step": 3,
      "unit": "px",
      "default": 0,
      "label": "Top margin"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 60,
      "step": 3,
      "unit": "px",
      "default": 0,
      "label": "Bottom margin"
    }
  ],
  "presets": [
    {
      "name": "Expert Quote"
    }
  ]
}
{% endschema %}
