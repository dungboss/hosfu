{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .why-pelvidex-{{ section.id }} {
    text-align: center;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__title {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 700;
    margin-bottom: 36px;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__item h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__item p {
    font-size: 14px;
    margin: 0;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
    background: #000;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__video-wrap iframe,
  .why-pelvidex-{{ section.id }} .why-pelvidex__video-wrap video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    color: #fff;
    border-radius: 8px;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__video-placeholder .play-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(255,255,255,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__video-placeholder .play-icon svg {
    width: 20px;
    height: 20px;
    fill: #fff;
    margin-left: 3px;
  }
  .why-pelvidex-{{ section.id }} .why-pelvidex__video-placeholder span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.8;
    text-transform: uppercase;
  }
  @media (max-width: 749px) {
    .why-pelvidex-{{ section.id }} .why-pelvidex__grid {
      grid-template-columns: 1fr;
      max-width: 340px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="why-pelvidex-{{ section.id }}">
    {%- unless section.settings.title == blank -%}
      <h2 class="why-pelvidex__title">{{ section.settings.title }}</h2>
    {%- endunless -%}

    <div class="why-pelvidex__grid">
      {%- for block in section.blocks -%}
        <div class="why-pelvidex__item" {{ block.shopify_attributes }}>
          <div class="why-pelvidex__video-wrap">
            {%- if block.settings.video_url != blank -%}
              {%- assign video_url = block.settings.video_url -%}
              {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
                {%- if video_url contains 'youtu.be/' -%}
                  {%- assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
                {%- else -%}
                  {%- assign yt_id = video_url | split: 'v=' | last | split: '&' | first -%}
                {%- endif -%}
                <iframe
                  src="https://www.youtube.com/embed/{{ yt_id }}?rel=0&modestbranding=1"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  title="{{ block.settings.title }}"
                ></iframe>
              {%- elsif video_url contains 'vimeo.com' -%}
                {%- assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ vimeo_id }}"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  title="{{ block.settings.title }}"
                ></iframe>
              {%- else -%}
                <video controls preload="none" title="{{ block.settings.title }}">
                  <source src="{{ video_url }}" type="video/mp4">
                </video>
              {%- endif -%}
            {%- else -%}
              <div class="why-pelvidex__video-placeholder">
                <div class="play-icon">
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <span>Video coming soon</span>
              </div>
            {%- endif -%}
          </div>
          {%- unless block.settings.title == blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endunless -%}
          {%- unless block.settings.text == blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why PelviDex",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why do you need the PelviDex™?"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "info": "Supports YouTube, Vimeo, or direct MP4 URL. Leave blank to show placeholder."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Column title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why PelviDex"
    }
  ]
}
{% endschema %}
