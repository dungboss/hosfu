{% liquid
  assign hero_media = product.featured_media
  assign problem_media = product.media | slice: 1, 1 | first
  assign expect_media_1 = product.media | slice: 2, 1 | first
  assign expect_media_2 = product.media | slice: 3, 1 | first
  assign expect_media_3 = product.media | slice: 4, 1 | first
  assign journey_media_1 = product.media | slice: 5, 1 | first
  assign journey_media_2 = product.media | slice: 6, 1 | first
  assign journey_media_3 = product.media | slice: 7, 1 | first
  assign voice_media_1 = product.media | slice: 8, 1 | first
  assign voice_media_2 = product.media | slice: 9, 1 | first
  assign voice_media_3 = product.media | slice: 10, 1 | first

  if problem_media == blank
    assign problem_media = hero_media
  endif

  assign hero_image = section.settings.hero_image | default: hero_media.preview_image
  assign problem_image = section.settings.problem_image | default: problem_media.preview_image
  assign intro_image = section.settings.intro_image | default: hero_media.preview_image
  assign results_image = section.settings.results_image | default: hero_media.preview_image
%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --epf-wine: #8d184d;
    --epf-wine-dark: #6c103b;
    --epf-rose: #f8eee8;
    --epf-cream: #fcf8f4;
    --epf-sand: #eadacb;
    --epf-text: #231815;
    --epf-muted: #6d5a53;
    --epf-line: rgba(141, 24, 77, 0.14);
    --epf-shadow: 0 18px 42px rgba(35, 24, 21, 0.08);
  }

  #shopify-section-{{ section.id }} .epf-story {
    background: linear-gradient(180deg, #fffdfb 0%, var(--epf-cream) 100%);
    color: var(--epf-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .epf-story__shell { max-width: 1180px; margin: 0 auto; }

  /* Grid System */
  #shopify-section-{{ section.id }} .epf-story__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  /* Introduction Style (Halsten) */
  #shopify-section-{{ section.id }} .epf-story__intro-wrapper { margin-top: 6rem; }
  #shopify-section-{{ section.id }} .epf-story__intro-main-heading { 
    text-align: center; 
    margin-bottom: 5rem; 
    font-size: clamp(3rem, 5vw, 4.8rem);
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .epf-story__intro-main-heading span { color: var(--epf-wine); font-weight: 800; }
  
  #shopify-section-{{ section.id }} .epf-story__intro-lead { font-size: 1.9rem; font-weight: 800; margin-bottom: 1.5rem; line-height: 1.4; }
  #shopify-section-{{ section.id }} .epf-story__intro-subtext { font-size: 1.45rem; font-weight: 600; margin-bottom: 3.5rem; color: var(--epf-muted); }

  #shopify-section-{{ section.id }} .epf-story__intro-grid { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 3rem 2rem; 
  }
  #shopify-section-{{ section.id }} .epf-story__intro-item { text-align: left; }
  #shopify-section-{{ section.id }} .epf-story__intro-icon { width: 48px; height: 48px; margin-bottom: 1.2rem; object-fit: contain; }
  #shopify-section-{{ section.id }} .epf-story__intro-item h3 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.8rem; }
  #shopify-section-{{ section.id }} .epf-story__intro-item h3 span { color: var(--epf-wine); }
  #shopify-section-{{ section.id }} .epf-story__intro-item p { font-size: 1.35rem; line-height: 1.6; color: var(--epf-muted); margin: 0; }

  /* Các phần khác kế thừa từ code cũ */
  .epf-story__hero { 
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2rem; padding: 2rem; 
    background: #fff; border-radius: 3rem; box-shadow: var(--epf-shadow); 
  }
  .epf-story__visual img { width: 100%; height: auto; border-radius: 2rem; display: block; }
  .epf-story__button--primary { 
    background: var(--epf-wine); color: #fff; padding: 1.5rem 3rem; 
    border-radius: 999px; text-decoration: none; font-weight: 800; display: inline-block; 
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .epf-story__split,
    #shopify-section-{{ section.id }} .epf-story__intro-grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .epf-story__intro-wrapper { margin-top: 4rem; }
  }
{%- endstyle -%}

<section class="epf-story">
  <div class="page-width epf-story__shell">
    
    {% comment %} 1. Hero Section {% endcomment %}
    <div class="epf-story__hero">
      <div class="epf-story__content">
        <h1 class="epf-story__heading" style="margin-bottom: 2rem;">{{ section.settings.hero_heading | replace: '[product_title]', product.title }}</h1>
        <p class="epf-story__lead" style="margin-bottom: 2rem;">{{ section.settings.hero_lead | newline_to_br }}</p>
        <a class="epf-story__button--primary" href="{{ section.settings.hero_primary_link }}">{{ section.settings.hero_primary_label }}</a>
      </div>
      <div class="epf-story__visual">
        <img src="{{ hero_image | image_url: width: 800 }}" loading="lazy">
      </div>
    </div>

    {% comment %} 2. Problem Section {% endcomment %}
    <div class="epf-story__section epf-story__split" style="margin-top: 6rem;">
      <div class="epf-story__content">
        <h2 style="font-size: 3rem; margin-bottom: 2rem;">{{ section.settings.problem_heading }}</h2>
        <p style="font-size: 1.6rem; color: var(--epf-muted);">{{ section.settings.problem_body }}</p>
      </div>
      <div class="epf-story__visual">
        <img src="{{ problem_image | image_url: width: 800 }}" loading="lazy">
      </div>
    </div>

    {% comment %} 3. INTRODUCTION (BẢN CHUẨN - KHÔNG NHÂN ĐÔI) {% endcomment %}
    <div class="epf-story__section epf-story__intro-wrapper" id="epf-intro">
      <h2 class="epf-story__intro-main-heading">{{ section.settings.intro_heading | replace: '[product_title]', product.title }}</h2>

      <div class="epf-story__split" style="align-items: flex-start;">
        <div class="epf-story__visual">
           {% if intro_image != blank %}
             <img src="{{ intro_image | image_url: width: 800 }}" loading="lazy">
           {% else %}
             {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
           {% endif %}
        </div>

        <div class="epf-story__content">
          {% if section.settings.intro_body != blank %}
            <p class="epf-story__intro-lead">{{ section.settings.intro_body | newline_to_br }}</p>
          {% endif %}

          {% if section.settings.intro_subtext != blank %}
            <p class="epf-story__intro-subtext">{{ section.settings.intro_subtext }}</p>
          {% endif %}

          <div class="epf-story__intro-grid">
            {% for block in section.blocks %}
              {% if block.type == 'intro_feature' %}
                <article class="epf-story__intro-item" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    <img src="{{ block.settings.icon | image_url: width: 100 }}" class="epf-story__intro-icon" loading="lazy">
                  {% endif %}
                  <h3>{{ block.settings.heading }}</h3>
                  <p>{{ block.settings.text | newline_to_br }}</p>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    {% comment %} 4. Các Section còn lại (What to expect, v.v...) {% endcomment %}
    <div class="epf-story__section" id="epf-what-to-expect" style="margin-top: 8rem;">
       <h2 style="text-align: center; margin-bottom: 4rem;">{{ section.settings.expect_heading }}</h2>
       {% comment %} Code What to expect tiếp tục tại đây... {% endcomment %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pelvic Floor Story",
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 44 },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "textarea", "id": "hero_heading", "label": "Heading", "default": "Confidence Starts Here" },
    { "type": "textarea", "id": "hero_lead", "label": "Lead Text" },
    { "type": "text", "id": "hero_primary_label", "label": "Button Label", "default": "Shop Now" },
    { "type": "text", "id": "hero_primary_link", "label": "Button Link", "default": "#" },
    { "type": "header", "content": "Problem" },
    { "type": "image_picker", "id": "problem_image", "label": "Problem image" },
    { "type": "textarea", "id": "problem_heading", "label": "Problem Heading" },
    { "type": "textarea", "id": "problem_body", "label": "Problem Body" },
    { "type": "header", "content": "Introduction" },
    { "type": "image_picker", "id": "intro_image", "label": "Introduction image" },
    { "type": "text", "id": "intro_heading", "label": "Main Heading (Centred)", "default": "Introducing <span>Halsten's</span> System" },
    { "type": "textarea", "id": "intro_body", "label": "Lead Text (Right Side)", "default": "Our proprietary system can restore collagen..." },
    { "type": "text", "id": "intro_subtext", "label": "Subtext (Above Grid)", "default": "Here's how it works:" },
    { "type": "header", "content": "What To Expect" },
    { "type": "text", "id": "expect_heading", "label": "Heading", "default": "What to Expect" }
  ],
  "blocks": [
    {
      "type": "intro_feature",
      "name": "Intro Feature Item",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "<span>660nm</span> wavelength" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [{ "name": "Pelvic Floor Story" }]
}
{% endschema %}