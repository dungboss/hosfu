          {% if block.type == 'testimonial' %}
            {% assign testimonial_index = testimonial_index | plus: 1 %}
            {% assign testimonial_image = block.settings.image %}
            {% if testimonial_image == blank %}
              {% case testimonial_index %}
                {% when 1 %}
                  {% if voice_media_1 != blank %}{% assign testimonial_image = voice_media_1.preview_image %}{% endif %}
                {% when 2 %}
                  {% if voice_media_2 != blank %}{% assign testimonial_image = voice_media_2.preview_image %}{% endif %}
                {% when 3 %}
                  {% if voice_media_3 != blank %}{% assign testimonial_image = voice_media_3.preview_image %}{% endif %}
              {% endcase %}
            {% endif %}
            <article class="epf-story__voice-card" {{ block.shopify_attributes }}>
              <div class="epf-story__voice-media">
                {% if testimonial_image != blank %}
                  {{
                    testimonial_image
                    | image_url: width: 720
                    | image_tag:
