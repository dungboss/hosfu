  /* Xử lý riêng cho block text cuối cùng không có icon */
  #shopify-section-{{ section.id }} .epf-story__intro-item.text-only {
    justify-content: center;
    text-align: left;
    align-items: flex-start;
  }
  
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .epf-story__intro-grid {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .epf-story__intro-wrapper {
      margin-top: 4rem;
    }
  }
