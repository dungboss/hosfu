    #shopify-section-{{ section.id }} .epf-story__feature-grid,
    #shopify-section-{{ section.id }} .epf-story__expect-grid,
    #shopify-section-{{ section.id }} .epf-story__journey-grid,
    #shopify-section-{{ section.id }} .epf-story__voice-grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .epf-story__hero-chip--top {
      right: 0.6rem;
