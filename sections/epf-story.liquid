    #shopify-section-{{ section.id }} .epf-story__metric-copy,
    #shopify-section-{{ section.id }} .epf-story__journey-card p,
    #shopify-section-{{ section.id }} .epf-story__voice-card p,
    #shopify-section-{{ section.id }} .epf-story__checks li {
      font-size: 1.4rem;
    }

    #shopify-section-{{ section.id }} .epf-story__proof {
      padding: 1rem;
      gap: 0.8rem;
    }

    #shopify-section-{{ section.id }} .epf-story__actions {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .epf-story__button {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .epf-story__featured {
      border-radius: 2.2rem;
      padding: 1rem;
    }

    #shopify-section-{{ section.id }} .epf-story__section {
      margin-top: 3.6rem;
    }

    #shopify-section-{{ section.id }} .epf-story__results,
    #shopify-section-{{ section.id }} .epf-story__problem-card-inner {
      padding: 1.3rem;
    }
  }
  /* --- BẮT ĐẦU CSS MỚI CHO PHẦN INTRO --- */
  #shopify-section-{{ section.id }} .epf-story__intro-wrapper {
    margin-top: 6rem;
  }
  
  #shopify-section-{{ section.id }} .epf-story__intro-main-heading {
    text-align: center;
    margin-bottom: 4rem;
    font-size: clamp(3rem, 4vw, 4.4rem);
    max-width: 900px;
    margin-inline: auto;
  }

  /* Hỗ trợ đổi màu chữ đỏ cho các từ nhấn mạnh */
  #shopify-section-{{ section.id }} .epf-story__intro-main-heading span {
    color: var(--epf-wine); 
  }

  #shopify-section-{{ section.id }} .epf-story__intro-lead {
    font-size: 1.8rem !important;
    font-weight: 800;
    color: var(--epf-text) !important;
    line-height: 1.4 !important;
    margin-bottom: 1.5rem !important;
  }

  #shopify-section-{{ section.id }} .epf-story__intro-subtext {
    font-size: 1.4rem !important;
    font-weight: 700;
    margin-bottom: 3.5rem !important;
  }

  #shopify-section-{{ section.id }} .epf-story__intro-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 2rem;
  }

  #shopify-section-{{ section.id }} .epf-story__intro-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .epf-story__intro-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 1.5rem;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .epf-story__intro-item h3 {
