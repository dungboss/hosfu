          {% if block.type == 'journey_card' %}
            {% assign journey_index = journey_index | plus: 1 %}
            {% assign journey_image = block.settings.image %}
            {% if journey_image == blank %}
              {% case journey_index %}
                {% when 1 %}
                  {% if journey_media_1 != blank %}{% assign journey_image = journey_media_1.preview_image %}{% endif %}
                {% when 2 %}
                  {% if journey_media_2 != blank %}{% assign journey_image = journey_media_2.preview_image %}{% endif %}
                {% when 3 %}
                  {% if journey_media_3 != blank %}{% assign journey_image = journey_media_3.preview_image %}{% endif %}
              {% endcase %}
            {% endif %}
            <article class="epf-story__journey-card" {{ block.shopify_attributes }}>
              <div class="epf-story__journey-media">
                {% if journey_image != blank %}
                  {{
                    journey_image
                    | image_url: width: 720
                    | image_tag:
                      loading: 'lazy',
                      widths: '260, 360, 540, 720',
                      sizes: '(min-width: 990px) 24vw, 90vw',
                      alt: block.settings.heading
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
                {% endif %}
              </div>
              <div class="epf-story__journey-body">
                <p class="epf-story__journey-kicker">{{ block.settings.kicker }}</p>
                <h3>{{ block.settings.heading | replace: '[product_title]', product.title }}</h3>
                <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.journey_cta_label != blank %}
        <div class="epf-story__journey-cta">
          <a class="epf-story__button epf-story__button--secondary" href="{{ section.settings.journey_cta_link | default: '#epf-questions' }}">
            {{ section.settings.journey_cta_label | replace: '[product_title]', product.title }}
          </a>
        </div>
      {% endif %}
    </div>

    <div class="epf-story__section">
      <div class="epf-story__section-header">
        <h2>{{ section.settings.testimonials_heading | replace: '[product_title]', product.title }}</h2>
