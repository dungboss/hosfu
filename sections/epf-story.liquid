    },
    {
      "type": "text",
      "id": "hero_primary_link",
      "label": "Primary button link",
      "default": "#MainProduct-offer_main"
    },
    {
      "type": "text",
      "id": "hero_secondary_label",
      "label": "Secondary button label",
      "default": "See what to expect"
    },
    {
      "type": "text",
      "id": "hero_secondary_link",
