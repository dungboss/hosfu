<section class="epf-story">
  <div class="page-width epf-story__shell">
    <div class="epf-story__hero">
      <div class="epf-story__hero-head">
        {% if section.settings.hero_eyebrow != blank %}
          <p class="epf-story__eyebrow">{{ section.settings.hero_eyebrow | replace: '[product_title]', product.title }}</p>
        {% endif %}
        <h1 class="epf-story__heading">{{ section.settings.hero_heading | replace: '[product_title]', product.title }}</h1>
      </div>

      <div class="epf-story__content">
        {% if section.settings.hero_lead != blank %}
          <p class="epf-story__lead">
            {{ section.settings.hero_lead | replace: '[product_title]', product.title | newline_to_br }}
          </p>
        {% endif %}

        <ul class="epf-story__checks">
          {% for block in section.blocks %}
            {% if block.type == 'hero_check' %}
              <li {{ block.shopify_attributes }}>
                <span class="epf-story__checkmark">&#10003;</span>
                <span>{{ block.settings.text | replace: '[product_title]', product.title }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        <div class="epf-story__actions">
          {% if section.settings.hero_primary_label != blank %}
            <a class="epf-story__button epf-story__button--primary" href="{{ section.settings.hero_primary_link | default: '#MainProduct-offer_main' }}">
              {{ section.settings.hero_primary_label | replace: '[product_title]', product.title }}
            </a>
          {% endif %}
          {% if section.settings.hero_secondary_label != blank %}
            <a class="epf-story__button epf-story__button--secondary" href="{{ section.settings.hero_secondary_link | default: '#epf-what-to-expect' }}">
              {{ section.settings.hero_secondary_label | replace: '[product_title]', product.title }}
            </a>
          {% endif %}
        </div>

        {% if section.settings.hero_proof_copy != blank %}
          <div class="epf-story__proof">
            <div class="epf-story__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <div class="epf-story__proof-copy">
              {{ section.settings.hero_proof_copy | replace: '[product_title]', product.title | newline_to_br }}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="epf-story__visual">
        <div class="epf-story__visual-ring"></div>
        <figure class="epf-story__figure">
          {% if hero_image != blank %}
            {{
              hero_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                sizes: '(min-width: 990px) 38vw, 90vw',
                alt: product.title
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
          {% endif %}
        </figure>
        {% if section.settings.hero_chip_top != blank %}
          <div class="epf-story__hero-chip epf-story__hero-chip--top">
            {{ section.settings.hero_chip_top | replace: '[product_title]', product.title }}
          </div>
        {% endif %}
        {% if section.settings.hero_chip_bottom != blank %}
          <div class="epf-story__hero-chip epf-story__hero-chip--bottom">
            {{ section.settings.hero_chip_bottom | replace: '[product_title]', product.title }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="epf-story__featured" aria-label="Featured on">
      <div class="epf-story__featured-label">{{ section.settings.featured_label | replace: '[product_title]', product.title }}</div>
      {% if section.settings.featured_image_url != blank %}
        <div class="epf-story__featured-media">
          <img
            class="epf-story__featured-image"
            src="{{ section.settings.featured_image_url | escape }}"
            alt="{{ section.settings.featured_image_alt | default: section.settings.featured_label | escape }}"
            loading="lazy"
          >
        </div>
      {% else %}
        <div class="epf-story__featured-grid">
          {% for block in section.blocks %}
            {% if block.type == 'featured_logo' %}
              <span class="epf-story__logo-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="epf-story__section epf-story__split">
      <div class="epf-story__content">
        <h2>{{ section.settings.problem_heading | replace: '[product_title]', product.title }}</h2>
        {% if section.settings.problem_body != blank %}
          <p>
            {{ section.settings.problem_body | replace: '[product_title]', product.title | newline_to_br }}
          </p>
        {% endif %}
        <div class="epf-story__note-list">
          {% for block in section.blocks %}
            {% if block.type == 'problem_note' %}
              <div class="epf-story__note" {{ block.shopify_attributes }}>
                {{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

<div class="epf-story__problem-card">
        <div class="epf-story__problem-media-full">
          {% if problem_image != blank %}
            {{
              problem_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '320, 480, 640, 780, 1200',
                sizes: '(min-width: 990px) 50vw, 90vw',
                alt: product.title
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
          {% endif %}
        </div>
      </div>

<div class="epf-story__section epf-story__intro-wrapper" id="epf-intro">
      <h2 class="epf-story__intro-main-heading">{{ section.settings.intro_heading | replace: '[product_title]', product.title }}</h2>

      <div class="epf-story__split" style="align-items: flex-start;">
        <div class="epf-story__visual">
           {% if intro_image != blank %}
            {{ intro_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'epf-story__featured-image', style: 'border-radius: 2rem;' }}
           {% else %}
            {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
           {% endif %}
        </div>




    <div class="epf-story__section epf-story__intro-wrapper" id="epf-intro">
      <h2 class="epf-story__intro-main-heading">{{ section.settings.intro_heading | replace: '[product_title]', product.title }}</h2>

      <div class="epf-story__split" style="align-items: flex-start;">
        <div class="epf-story__visual">
           {% if intro_image != blank %}
            {{ intro_image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'epf-story__featured-image', style: 'border-radius: 2rem;' }}
           {% else %}
            {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
           {% endif %}
        </div>

        <div class="epf-story__content">
          {% if section.settings.intro_body != blank %}
            <p class="epf-story__intro-lead">{{ section.settings.intro_body | replace: '[product_title]', product.title | newline_to_br }}</p>
          {% endif %}

          {% if section.settings.intro_subtext != blank %}
            <p class="epf-story__intro-subtext">{{ section.settings.intro_subtext | replace: '[product_title]', product.title }}</p>
          {% endif %}

          <div class="epf-story__intro-grid">
            {% for block in section.blocks %}
              {% if block.type == 'intro_feature' %}
                <article class="epf-story__intro-item {% if block.settings.icon == blank %}text-only{% endif %}" {{ block.shopify_attributes }}>
                  {% if block.settings.icon != blank %}
                    <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="" class="epf-story__intro-icon" loading="lazy">
                  {% endif %}

                  {% if block.settings.heading != blank %}
                    <h3>{{ block.settings.heading }}</h3>
                  {% endif %}

                  <p>{{ block.settings.text | newline_to_br }}</p>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>


    <div class="epf-story__section" id="epf-what-to-expect">
      <div class="epf-story__section-header">
        <h2>{{ section.settings.expect_heading | replace: '[product_title]', product.title }}</h2>
      </div>

      <div class="epf-story__expect-grid">
        {% assign expect_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'expect_card' %}
            {% assign expect_index = expect_index | plus: 1 %}
            {% assign expect_image = block.settings.image %}
            {% if expect_image == blank %}
              {% case expect_index %}
                {% when 1 %}
                  {% if expect_media_1 != blank %}{% assign expect_image = expect_media_1.preview_image %}{% endif %}
                {% when 2 %}
                  {% if expect_media_2 != blank %}{% assign expect_image = expect_media_2.preview_image %}{% endif %}
                {% when 3 %}
                  {% if expect_media_3 != blank %}{% assign expect_image = expect_media_3.preview_image %}{% endif %}
              {% endcase %}
            {% endif %}
            <article class="epf-story__card" {{ block.shopify_attributes }}>
              <div class="epf-story__card-media">
                {% if expect_image != blank %}
                  {{
                    expect_image
                    | image_url: width: 720
                    | image_tag:
                      loading: 'lazy',
                      widths: '260, 360, 540, 720',
                      sizes: '(min-width: 990px) 24vw, 90vw',
                      alt: block.settings.heading
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
                {% endif %}
              </div>
              <div class="epf-story__card-body">
                <p class="epf-story__step-kicker">{{ block.settings.kicker }}</p>
                <h3>{{ block.settings.heading | replace: '[product_title]', product.title }}</h3>
                <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.expect_cta_label != blank %}
        <div class="epf-story__expect-cta">
          <a class="epf-story__button epf-story__button--primary" href="{{ section.settings.expect_cta_link | default: '#MainProduct-offer_main' }}">
            {{ section.settings.expect_cta_label | replace: '[product_title]', product.title }}
          </a>
        </div>
      {% endif %}
    </div>

    <div class="epf-story__section">
      <div class="epf-story__results">
        <div class="epf-story__results-visual">
          {% if results_image != blank %}
            {{
              results_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '320, 480, 640, 900',
                sizes: '(min-width: 990px) 28vw, 90vw',
                alt: product.title
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}
          {% endif %}
          <div class="epf-story__results-glow"></div>
        </div>

        <div class="epf-story__content">
          <h2>{{ section.settings.results_heading | replace: '[product_title]', product.title }}</h2>
          {% if section.settings.results_body != blank %}
            <p>
              {{ section.settings.results_body | replace: '[product_title]', product.title | newline_to_br }}
            </p>
          {% endif %}

          <div class="epf-story__metric-list">
            {% for block in section.blocks %}
              {% if block.type == 'result_metric' %}
                <div class="epf-story__metric" {{ block.shopify_attributes }}>
                  <span class="epf-story__metric-icon">&#10003;</span>
                  <p class="epf-story__metric-copy">
                    {{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}
                  </p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <div class="epf-story__section">
      <div class="epf-story__section-header">
        <h2>{{ section.settings.journey_heading | replace: '[product_title]', product.title }}</h2>
      </div>

      <div class="epf-story__journey-grid">
        {% assign journey_index = 0 %}
