{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .bladder-steps-{{ section.id }} {
    text-align: center;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__title {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 700;
    margin-bottom: 36px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 28px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 10px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item p {
    font-size: 14px;
    margin: 0;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
    background: #000;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__image-wrap {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__image-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-wrap iframe,
  .bladder-steps-{{ section.id }} .bladder-steps__video-wrap video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    color: #fff;
    border-radius: 8px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder .play-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(255,255,255,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder .play-icon svg {
    width: 20px;
    height: 20px;
    fill: #fff;
    margin-left: 3px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.8;
    text-transform: uppercase;
  }
  @media (max-width: 749px) {
    .bladder-steps-{{ section.id }} .bladder-steps__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="bladder-steps-{{ section.id }}">
    {%- unless section.settings.title == blank -%}
      <h2 class="bladder-steps__title">{{ section.settings.title }}</h2>
    {%- endunless -%}

    <div class="bladder-steps__grid">
      {%- for block in section.blocks -%}
        <div class="bladder-steps__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="bladder-steps__image-wrap">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
            </div>
          {%- elsif block.settings.video_url != blank -%}
          <div class="bladder-steps__video-wrap">
            {%- assign video_url = block.settings.video_url -%}
            {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
              {%- if video_url contains 'youtu.be/' -%}
                {%- assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
              {%- else -%}
                {%- assign yt_id = video_url | split: 'v=' | last | split: '&' | first -%}
              {%- endif -%}
              <iframe
                src="https://www.youtube.com/embed/{{ yt_id }}?rel=0&modestbranding=1"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
                title="{{ block.settings.title }}"
              ></iframe>
            {%- elsif video_url contains 'vimeo.com' -%}
              {%- assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first -%}
              <iframe
                src="https://player.vimeo.com/video/{{ vimeo_id }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                loading="lazy"
                title="{{ block.settings.title }}"
              ></iframe>
            {%- else -%}
              <video controls preload="none" title="{{ block.settings.title }}">
                <source src="{{ video_url }}" type="video/mp4">
              </video>
            {%- endif -%}
          </div>
          {%- endif -%}
          {%- unless block.settings.title == blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endunless -%}
          {%- unless block.settings.text == blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bladder Control Steps",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bladder Control Has Never Been Easier"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "If set, image will be shown instead of video."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "info": "Supports YouTube, Vimeo, or direct MP4 URL. Used only when no image is set."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bladder Control Steps"
    }
  ]
}
{% endschema %}
