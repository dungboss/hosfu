{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .bladder-steps-{{ section.id }} {
    text-align: center;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__title {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 700;
    margin-bottom: 36px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 28px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item h3 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 10px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item p {
    font-size: 14px;
    margin: 0;
  }
  {%- if section.settings.card_style == 'icon_left' -%}
  .bladder-steps-{{ section.id }} .bladder-steps__grid {
    max-width: 1180px;
    gap: 20px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item {
    position: relative;
    align-items: flex-start;
    text-align: left;
    padding: 26px 20px 26px 64px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item h3 {
    display: block;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .01em;
    line-height: 1.2;
    margin: 0 0 8px;
    white-space: nowrap;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item h3 .wc-ic {
    position: absolute;
    left: 20px;
    top: 22px;
    font-size: 32px;
    line-height: 1;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item h3 .wc-tt {
    display: block;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item p {
    font-size: 12.5px;
    line-height: 1.5;
  }
  {%- endif -%}
  {%- if section.settings.card_style == 'level' -%}
  .bladder-steps-{{ section.id }} .bladder-steps__grid {
    max-width: 1040px;
    gap: 18px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item {
    padding: 16px 14px;
    min-height: 96px;
    justify-content: center;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item:nth-child(1) { border-top: 4px solid #4caf78 !important; }
  .bladder-steps-{{ section.id }} .bladder-steps__item:nth-child(2) { border-top: 4px solid #c8a04a !important; }
  .bladder-steps-{{ section.id }} .bladder-steps__item:nth-child(3) { border-top: 4px solid #e8872a !important; }
  .bladder-steps-{{ section.id }} .bladder-steps__item:nth-child(4) { border-top: 4px solid #e83040 !important; }
  .bladder-steps-{{ section.id }} .bladder-steps__item h3 {
    font-size: 26px;
    font-weight: 800;
    line-height: 1;
    color: #fff;
    margin: 0 0 6px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item h3 span {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    margin-top: 8px !important;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__item p {
    font-size: 12.5px;
    color: #b3b3b3;
    margin: 0;
    white-space: nowrap;
  }
  {%- endif -%}
  .bladder-steps-{{ section.id }} .bladder-steps__video-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
    background: #000;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__image-wrap {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__image-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-wrap iframe,
  .bladder-steps-{{ section.id }} .bladder-steps__video-wrap video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    color: #fff;
    border-radius: 8px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder .play-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(255,255,255,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder .play-icon svg {
    width: 20px;
    height: 20px;
    fill: #fff;
    margin-left: 3px;
  }
  .bladder-steps-{{ section.id }} .bladder-steps__video-placeholder span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.8;
    text-transform: uppercase;
  }
  @media (max-width: 749px) {
    .bladder-steps-{{ section.id }} .bladder-steps__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="bladder-steps-{{ section.id }}">
    {%- unless section.settings.title == blank -%}
      <h2 class="bladder-steps__title">{{ section.settings.title }}</h2>
    {%- endunless -%}

    <div class="bladder-steps__grid">
      {%- for block in section.blocks -%}
        <div class="bladder-steps__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="bladder-steps__image-wrap">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
            </div>
          {%- elsif block.settings.video != blank -%}
            <div class="bladder-steps__video-wrap">
              <video autoplay muted loop playsinline preload="auto" title="{{ block.settings.title }}">
                {%- for source in block.settings.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            </div>
          {%- elsif block.settings.video_url != blank -%}
            <div class="bladder-steps__video-wrap">
              {%- assign video_url = block.settings.video_url -%}
              {%- if video_url contains 'youtube.com' or video_url contains 'youtu.be' -%}
                {%- if video_url contains 'youtu.be/' -%}
                  {%- assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
                {%- else -%}
                  {%- assign yt_id = video_url | split: 'v=' | last | split: '&' | first -%}
                {%- endif -%}
                <iframe
                  src="https://www.youtube.com/embed/{{ yt_id }}?rel=0&modestbranding=1&autoplay=1&mute=1&loop=1&playlist={{ yt_id }}"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  title="{{ block.settings.title }}"
                ></iframe>
              {%- elsif video_url contains 'vimeo.com' -%}
                {%- assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ vimeo_id }}?autoplay=1&muted=1&loop=1&background=1"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  title="{{ block.settings.title }}"
                ></iframe>
              {%- else -%}
                <video autoplay muted loop playsinline preload="auto" title="{{ block.settings.title }}">
                  <source src="{{ video_url }}" type="video/mp4">
                </video>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- unless block.settings.title == blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endunless -%}
          {%- unless block.settings.text == blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bladder Control Steps",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Bladder Control Has Never Been Easier"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "icon_left", "label": "Icon left, text left-aligned" },
        { "value": "level", "label": "Level cards (big number + colored top border)" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "If set, shown instead of video."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (from library)",
          "info": "Pick a video from your Shopify Files library. Used when no image is set."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL",
          "info": "YouTube, Vimeo, or direct MP4 URL. Used when no image or library video is set."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bladder Control Steps"
    }
  ]
}
{% endschema %}
