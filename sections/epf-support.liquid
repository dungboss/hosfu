    }

  }



  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .epf-story__hero {

      padding: 1.45rem;

      border-radius: 2.4rem;

      gap: 1.35rem;

    }



    #shopify-section-{{ section.id }} .epf-story__hero > .epf-story__visual {

      order: -1;

    }



    #shopify-section-{{ section.id }} .epf-story__heading {

      font-size: clamp(2.5rem, 10vw, 4rem);

      max-width: none;

    }



    #shopify-section-{{ section.id }} .epf-story__lead,

    #shopify-section-{{ section.id }} .epf-story__content p,

    #shopify-section-{{ section.id }} .epf-story__metric-copy,

    #shopify-section-{{ section.id }} .epf-story__journey-card p,

    #shopify-section-{{ section.id }} .epf-story__voice-card p,

