      gap: 0.8rem;

    }



    #shopify-section-{{ section.id }} .epf-story__actions {

      flex-direction: column;

    }



    #shopify-section-{{ section.id }} .epf-story__button {

      width: 100%;

    }



    #shopify-section-{{ section.id }} .epf-story__featured {

      border-radius: 2.2rem;

      padding: 1rem;

    }



    #shopify-section-{{ section.id }} .epf-story__section {

      margin-top: 3.6rem;

    }



    #shopify-section-{{ section.id }} .epf-story__results,

    #shopify-section-{{ section.id }} .epf-story__problem-card-inner {

      padding: 1.3rem;

    }

