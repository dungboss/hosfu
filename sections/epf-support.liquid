{%- style -%}
  {% assign review_blocks_count = 0 %}
  {% assign review_image_1 = blank %}
  {% assign review_image_2 = blank %}
  {% assign review_image_3 = blank %}

  {% assign review_media_1 = product.media | slice: 8, 1 | first %}
  {% assign review_media_2 = product.media | slice: 9, 1 | first %}
  {% assign review_media_3 = product.media | slice: 10, 1 | first %}

  {% if review_media_1 != blank %}
    {% assign review_image_1 = review_media_1.preview_image %}
  {% endif %}
  {% if review_media_2 != blank %}
    {% assign review_image_2 = review_media_2.preview_image %}
  {% endif %}
  {% if review_media_3 != blank %}
    {% assign review_image_3 = review_media_3.preview_image %}
  {% endif %}

  {% if review_image_1 == blank and product.featured_media != blank %}
    {% assign review_image_1 = product.featured_media.preview_image %}
  {% endif %}
  {% if review_image_2 == blank and product.featured_media != blank %}
    {% assign review_image_2 = product.featured_media.preview_image %}
  {% endif %}
  {% if review_image_3 == blank and product.featured_media != blank %}
    {% assign review_image_3 = product.featured_media.preview_image %}
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == 'review_item' %}
      {% assign review_blocks_count = review_blocks_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  #shopify-section-{{ section.id }} {
    --epf-wine: #8d184d;
    --epf-wine-dark: #6c103b;
    --epf-rose: #f8eee8;
    --epf-cream: #fcf8f4;
    --epf-text: #231815;
    --epf-muted: #6d5a53;
    --epf-line: rgba(141, 24, 77, 0.14);
  }

  #shopify-section-{{ section.id }} .epf-support {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
    background:
      linear-gradient(180deg, var(--epf-cream) 0%, #fffdfb 42%, #f7efe8 100%);
    color: var(--epf-text);
  }

  #shopify-section-{{ section.id }} .epf-support__band {
    background: linear-gradient(135deg, var(--epf-wine) 0%, var(--epf-wine-dark) 100%);
    border-radius: 3rem;
    color: #fff;
    padding: 1.4rem;
    box-shadow: 0 18px 40px rgba(35, 24, 21, 0.12);
  }

  #shopify-section-{{ section.id }} .epf-support__band-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .epf-support__band-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: start;
    padding: 1rem 1.1rem;
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  #shopify-section-{{ section.id }} .epf-support__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .epf-support__band-card strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 1.35rem;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .epf-support__band-card p {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.84);
  }

  #shopify-section-{{ section.id }} .epf-support__faq {
    margin-top: 3rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 3rem;
    padding: 2rem;
    box-shadow: 0 18px 40px rgba(35, 24, 21, 0.08);
  }

  #shopify-section-{{ section.id }} .epf-support__heading {
    text-align: center;
    max-width: 60rem;
    margin: 0 auto 1.8rem;
  }

  #shopify-section-{{ section.id }} .epf-support__heading h2 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 4vw, 4.4rem);
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .epf-support__heading p {
    margin: 1rem 0 0;
    font-size: 1.55rem;
    line-height: 1.7;
    color: var(--epf-muted);
  }

  #shopify-section-{{ section.id }} .epf-support__items {
    display: grid;
    gap: 0.85rem;
  }

  #shopify-section-{{ section.id }} .epf-support__faq-item {
    background: #fff;
    border: 1px solid var(--epf-line);
    border-radius: 1.9rem;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .epf-support__faq-item summary {
    list-style: none;
    cursor: pointer;
    position: relative;
    padding: 1.4rem 4.6rem 1.4rem 1.5rem;
    font-size: 1.5rem;
    line-height: 1.5;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .epf-support__faq-item summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .epf-support__faq-item summary::before,
  #shopify-section-{{ section.id }} .epf-support__faq-item summary::after {
    content: "";
    position: absolute;
    right: 1.8rem;
    top: 50%;
    width: 1.6rem;
    height: 0.2rem;
    background: var(--epf-wine);
    transform: translateY(-50%);
    border-radius: 999px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .epf-support__faq-item summary::after {
    transform: translateY(-50%) rotate(90deg);
  }

  #shopify-section-{{ section.id }} .epf-support__faq-item[open] summary::after {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .epf-support__faq-answer {
    padding: 0 1.5rem 1.5rem;
    color: var(--epf-muted);
    font-size: 1.45rem;
    line-height: 1.75;
  }

  #shopify-section-{{ section.id }} .epf-support__note {
    margin-top: 1.6rem;
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--epf-muted);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .epf-support__reviews {
    margin-top: 3rem;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 3rem;
    padding: 2rem;
    box-shadow: 0 18px 40px rgba(35, 24, 21, 0.08);
  }

  #shopify-section-{{ section.id }} .epf-support__reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .epf-support__review-card {
    background: #fff;
    border: 1px solid var(--epf-line);
    border-radius: 2rem;
    padding: 1.5rem;
    box-shadow: 0 12px 28px rgba(35, 24, 21, 0.04);
  }

  #shopify-section-{{ section.id }} .epf-support__review-media {
    margin-bottom: 1rem;
    border-radius: 1.6rem;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #f4ece6;
  }

  #shopify-section-{{ section.id }} .epf-support__review-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .epf-support__review-stars {
    color: #e2a300;
    font-size: 1.45rem;
    letter-spacing: 0.18em;
    margin-bottom: 0.9rem;
  }

  #shopify-section-{{ section.id }} .epf-support__review-card h3 {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .epf-support__review-copy {
    margin: 1rem 0 0;
    font-size: 1.42rem;
    line-height: 1.72;
    color: var(--epf-muted);
  }

  #shopify-section-{{ section.id }} .epf-support__review-author {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(141, 24, 77, 0.12);
  }

  #shopify-section-{{ section.id }} .epf-support__review-author strong {
    display: block;
    font-size: 1.35rem;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .epf-support__review-author span {
    display: block;
    margin-top: 0.15rem;
    font-size: 1.2rem;
    line-height: 1.5;
    color: var(--epf-muted);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .epf-support {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .epf-support__band-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .epf-support__reviews-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .epf-support__band,
    #shopify-section-{{ section.id }} .epf-support__faq,
    #shopify-section-{{ section.id }} .epf-support__reviews {
      border-radius: 2.2rem;
      padding: 1.3rem;
    }

    #shopify-section-{{ section.id }} .epf-support__band-grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .epf-support__heading p,
    #shopify-section-{{ section.id }} .epf-support__faq-answer,
    #shopify-section-{{ section.id }} .epf-support__faq-item summary,
    #shopify-section-{{ section.id }} .epf-support__review-copy {
      font-size: 1.4rem;
    }
  }
{%- endstyle -%}

<section class="epf-support" id="{{ section.settings.section_anchor | default: 'epf-questions' }}">
  <div class="page-width">
    <div class="epf-support__band">
      <div class="epf-support__band-grid">
        {% for block in section.blocks %}
          {% if block.type == 'support_point' %}
            <div class="epf-support__band-card" {{ block.shopify_attributes }}>
              <span class="epf-support__icon">{{ block.settings.icon_text | default: '✓' }}</span>
              <div>
                <strong>{{ block.settings.title | replace: '[product_title]', product.title }}</strong>
                <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="epf-support__faq">
      <div class="epf-support__heading">
        <h2>{{ section.settings.faq_heading | replace: '[product_title]', product.title }}</h2>
        {% if section.settings.faq_description != blank %}
          <p>{{ section.settings.faq_description | replace: '[product_title]', product.title | newline_to_br }}</p>
        {% endif %}
      </div>

      <div class="epf-support__items">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <details class="epf-support__faq-item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | replace: '[product_title]', product.title }}</summary>
              <div class="epf-support__faq-answer">
                {{ block.settings.answer | replace: '[product_title]', product.title | newline_to_br }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.wellness_note != blank %}
        <p class="epf-support__note">
          {{ section.settings.wellness_note | replace: '[product_title]', product.title | newline_to_br }}
        </p>
      {% endif %}
    </div>

    {% if review_blocks_count > 0 %}
      <div class="epf-support__reviews">
        <div class="epf-support__heading">
          <h2>{{ section.settings.reviews_heading | replace: '[product_title]', product.title }}</h2>
          {% if section.settings.reviews_description != blank %}
            <p>{{ section.settings.reviews_description | replace: '[product_title]', product.title | newline_to_br }}</p>
          {% endif %}
        </div>

        <div class="epf-support__reviews-grid">
          {% assign review_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'review_item' %}
              {% assign review_index = review_index | plus: 1 %}
              {% assign review_image = block.settings.image %}
              {% if review_image == blank %}
                {% case review_index %}
                  {% when 1 %}
                    {% assign review_image = review_image_1 %}
                  {% when 2 %}
                    {% assign review_image = review_image_2 %}
                  {% when 3 %}
                    {% assign review_image = review_image_3 %}
                {% endcase %}
              {% endif %}
              <article class="epf-support__review-card" {{ block.shopify_attributes }}>
                {% if review_image != blank %}
                  <div class="epf-support__review-media">
                    {{
                      review_image
                      | image_url: width: 720
                      | image_tag:
                        class: 'epf-support__review-image',
                        loading: 'lazy',
                        widths: '240, 360, 540, 720',
                        sizes: '(min-width: 990px) 22vw, 90vw',
                        alt: block.settings.author | default: block.settings.title
                    }}
                  </div>
                {% endif %}
                {% if block.settings.stars != blank %}
                  <div class="epf-support__review-stars">{{ block.settings.stars }}</div>
                {% endif %}
                <h3>{{ block.settings.title | replace: '[product_title]', product.title }}</h3>
                <div class="epf-support__review-copy">
                  {{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}
                </div>
                {% if block.settings.author != blank or block.settings.meta != blank %}
                  <div class="epf-support__review-author">
                    {% if block.settings.author != blank %}
                      <strong>{{ block.settings.author }}</strong>
                    {% endif %}
                    {% if block.settings.meta != blank %}
                      <span>{{ block.settings.meta }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Pelvic Floor Support",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    },
    {
      "type": "text",
      "id": "section_anchor",
      "label": "Section anchor",
      "default": "epf-questions"
    },
    {
      "type": "header",
      "content": "FAQ"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "Heading",
      "default": "Questions from Women Just Like You"
    },
    {
      "type": "textarea",
      "id": "faq_description",
      "label": "Description",
      "default": "Short answers to the things women ask before starting an at-home pelvic floor support routine."
    },
    {
      "type": "textarea",
      "id": "wellness_note",
      "label": "Wellness note",
      "default": "Wellness note: this page is intended for general product information only and should not replace individualized medical advice."
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Heading",
      "default": "Reviews from Women Like You"
    },
    {
      "type": "textarea",
      "id": "reviews_description",
      "label": "Description",
      "default": "Real words from women building steadier routines and more everyday confidence with [product_title]."
    }
  ],
  "blocks": [
    {
      "type": "support_point",
      "name": "Support Point",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "icon_text",
          "label": "Icon text",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "30-day confidence promise"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Try it in your home routine and make sure it feels right for you."
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "limit": 16,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "I've tried Kegels before. How is this different?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Most women don't need more reminders. They need a routine that feels easier to repeat. [product_title] is designed to make the habit feel more approachable, structured, and realistic at home."
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "review_item",
      "name": "Review Item",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "stars",
          "label": "Stars",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "\"It finally felt easy to stay consistent.\""
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "\"I had tried on and off routines before, but [product_title] felt simple enough to actually keep using. That made the difference for me.\""
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Maria L."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta",
          "default": "Verified customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pelvic Floor Support",
      "blocks": [
        {
          "type": "support_point"
        },
        {
          "type": "support_point"
        },
        {
          "type": "support_point"
        },
        {
          "type": "support_point"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "review_item"
        },
        {
          "type": "review_item"
        },
        {
          "type": "review_item"
        }
      ]
    }
  ]
}
{% endschema %}
