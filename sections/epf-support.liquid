  #shopify-section-{{ section.id }} .epf-support__panel {

    margin-top: 5rem;

    padding: 2.2rem;

    border-radius: 3rem;

    background: rgba(255, 255, 255, 0.82);

    border: 1px solid rgba(255, 255, 255, 0.9);

    box-shadow: var(--epf-shadow);

  }



  #shopify-section-{{ section.id }} .epf-support__header {

    max-width: 72rem;

  }



  #shopify-section-{{ section.id }} .epf-support__header p {

    font-size: 1.6rem;

    line-height: 1.7;

    color: var(--epf-muted);

    margin: 1.2rem 0 0;

  }



  #shopify-section-{{ section.id }} .epf-support__points {

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 1.4rem;

    margin-top: 2.2rem;

  }



  #shopify-section-{{ section.id }} .epf-support__point {

    display: grid;

    grid-template-columns: auto 1fr;

    gap: 1rem;

    align-items: flex-start;

    padding: 1.6rem;

    border-radius: 2rem;

    background: #fff;

    border: 1px solid var(--epf-line);

  }



  #shopify-section-{{ section.id }} .epf-support__point-icon {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 3.2rem;

    height: 3.2rem;

    border-radius: 999px;

    background: rgba(141, 24, 77, 0.1);

    color: var(--epf-wine);

    font-size: 1.45rem;

    font-weight: 800;

    line-height: 1;

  }



  #shopify-section-{{ section.id }} .epf-support__point h3 {

    margin: 0 0 0.45rem;

    font-family: var(--font-heading-family);

    font-size: 1.8rem;

    line-height: 1.25;

  }



  #shopify-section-{{ section.id }} .epf-support__point p {

    margin: 0;

    color: var(--epf-muted);

    font-size: 1.45rem;

    line-height: 1.65;

  }



  #shopify-section-{{ section.id }} .epf-support__faq {

    margin-top: 2.4rem;

  }



  #shopify-section-{{ section.id }} .epf-support__faq-list {

    display: grid;

    gap: 1rem;

  }



  #shopify-section-{{ section.id }} .epf-support__faq-item {

    border-radius: 2rem;

    border: 1px solid var(--epf-line);

    background: #fff;

    overflow: hidden;

  }



  #shopify-section-{{ section.id }} .epf-support__faq-item summary {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 1rem;

    padding: 1.7rem;

    font-family: var(--font-heading-family);

    font-size: 1.75rem;

    line-height: 1.35;

  }



  #shopify-section-{{ section.id }} .epf-support__faq-item summary::-webkit-details-marker {

    display: none;

  }



  #shopify-section-{{ section.id }} .epf-support__faq-toggle {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 2.6rem;

    height: 2.6rem;

    border-radius: 999px;

    background: rgba(141, 24, 77, 0.08);

    color: var(--epf-wine);

    font-size: 1.8rem;

    font-weight: 700;

    line-height: 1;

    flex: 0 0 auto;

    transition: transform 0.2s ease;

  }



  #shopify-section-{{ section.id }} .epf-support__faq-item[open] .epf-support__faq-toggle {

    transform: rotate(45deg);

  }



  #shopify-section-{{ section.id }} .epf-support__faq-answer {

    padding: 0 1.7rem 1.7rem;

    color: var(--epf-muted);

    font-size: 1.5rem;

    line-height: 1.7;

  }



  #shopify-section-{{ section.id }} .epf-support__faq-answer p {

    margin: 0;

  }



  #shopify-section-{{ section.id }} .epf-support__wellness {

    margin-top: 1.4rem;

    color: var(--epf-muted);

    font-size: 1.35rem;

    line-height: 1.65;

  }



  #shopify-section-{{ section.id }} .epf-support__reviews {

    margin-top: 3rem;

  }



  #shopify-section-{{ section.id }} .epf-support__reviews-grid {

    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 1.4rem;

    margin-top: 2rem;

  }



  #shopify-section-{{ section.id }} .epf-support__review-card {

    display: flex;

    flex-direction: column;

    gap: 1rem;

    padding: 1.7rem;

    border-radius: 2rem;

    background: #fff;

    border: 1px solid var(--epf-line);

  }



  #shopify-section-{{ section.id }} .epf-support__review-stars {

    color: #f2b731;

    font-size: 1.55rem;

    letter-spacing: 0.12em;

    line-height: 1;

  }



  #shopify-section-{{ section.id }} .epf-support__review-meta {

    color: var(--epf-muted);

    font-size: 1.25rem;

    font-weight: 700;

    letter-spacing: 0.06em;

    text-transform: uppercase;

  }



  #shopify-section-{{ section.id }} .epf-support__review-card h3 {

    margin: 0;

    font-family: var(--font-heading-family);

    font-size: 2rem;

    line-height: 1.3;

  }



  #shopify-section-{{ section.id }} .epf-support__review-card p {

    margin: 0;

    color: var(--epf-muted);

    font-size: 1.5rem;

    line-height: 1.7;

  }



  #shopify-section-{{ section.id }} .epf-support__review-author {

    margin-top: auto;

    font-size: 1.45rem;

    font-weight: 700;

    color: var(--epf-text);

  }



  @media screen and (max-width: 989px) {

    #shopify-section-{{ section.id }} .epf-support__points,

    #shopify-section-{{ section.id }} .epf-support__reviews-grid {

      grid-template-columns: repeat(2, minmax(0, 1fr));

    }

  }



  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .epf-support__panel {

      padding: 1.6rem;

      border-radius: 2.4rem;

    }



    #shopify-section-{{ section.id }} .epf-support__points,

    #shopify-section-{{ section.id }} .epf-support__reviews-grid {

      grid-template-columns: minmax(0, 1fr);

    }



    #shopify-section-{{ section.id }} .epf-support__faq-item summary {

      padding: 1.4rem;

      font-size: 1.6rem;

    }



    #shopify-section-{{ section.id }} .epf-support__faq-answer {

      padding: 0 1.4rem 1.4rem;

    }

  }

{%- endstyle -%}



<section class="epf-story">

  <div class="page-width epf-story__shell">

    <div class="epf-story__hero">

      <div class="epf-story__hero-head">

        {% if section.settings.hero_eyebrow != blank %}

          <p class="epf-story__eyebrow">{{ section.settings.hero_eyebrow | replace: '[product_title]', product.title }}</p>

        {% endif %}

        <h1 class="epf-story__heading">{{ section.settings.hero_heading | replace: '[product_title]', product.title }}</h1>

      </div>



      <div class="epf-story__content">

        {% if section.settings.hero_lead != blank %}

          <p class="epf-story__lead">

            {{ section.settings.hero_lead | replace: '[product_title]', product.title | newline_to_br }}

          </p>

        {% endif %}



        <ul class="epf-story__checks">

          {% for block in section.blocks %}

            {% if block.type == 'hero_check' %}

              <li {{ block.shopify_attributes }}>

                <span class="epf-story__checkmark">&#10003;</span>

                <span>{{ block.settings.text | replace: '[product_title]', product.title }}</span>

              </li>

            {% endif %}

          {% endfor %}

        </ul>



        <div class="epf-story__actions">

          {% if section.settings.hero_primary_label != blank %}

            <a class="epf-story__button epf-story__button--primary" href="{{ section.settings.hero_primary_link | default: '#MainProduct-offer_main' }}">

              {{ section.settings.hero_primary_label | replace: '[product_title]', product.title }}

            </a>

          {% endif %}

          {% if section.settings.hero_secondary_label != blank %}

            <a class="epf-story__button epf-story__button--secondary" href="{{ section.settings.hero_secondary_link | default: '#epf-what-to-expect' }}">

              {{ section.settings.hero_secondary_label | replace: '[product_title]', product.title }}

            </a>

          {% endif %}

        </div>



        {% if section.settings.hero_proof_copy != blank %}

          <div class="epf-story__proof">

            <div class="epf-story__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>

            <div class="epf-story__proof-copy">

              {{ section.settings.hero_proof_copy | replace: '[product_title]', product.title | newline_to_br }}

            </div>

          </div>

        {% endif %}

      </div>



      <div class="epf-story__visual">

        <div class="epf-story__visual-ring"></div>

        <figure class="epf-story__figure">

          {% if hero_image != blank %}

            {{

              hero_image

              | image_url: width: 900

              | image_tag:

                loading: 'lazy',

                widths: '360, 540, 720, 900',

                sizes: '(min-width: 990px) 38vw, 90vw',

                alt: product.title

            }}

          {% else %}

            {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}

          {% endif %}

        </figure>

        {% if section.settings.hero_chip_top != blank %}

          <div class="epf-story__hero-chip epf-story__hero-chip--top">

            {{ section.settings.hero_chip_top | replace: '[product_title]', product.title }}

          </div>

        {% endif %}

        {% if section.settings.hero_chip_bottom != blank %}

          <div class="epf-story__hero-chip epf-story__hero-chip--bottom">

            {{ section.settings.hero_chip_bottom | replace: '[product_title]', product.title }}

          </div>

        {% endif %}

      </div>

    </div>



    <div class="epf-story__featured" aria-label="Featured on">

      <div class="epf-story__featured-label">{{ section.settings.featured_label | replace: '[product_title]', product.title }}</div>

      {% if section.settings.featured_image_url != blank %}

        <div class="epf-story__featured-media">

          <img

            class="epf-story__featured-image"

            src="{{ section.settings.featured_image_url | escape }}"

            alt="{{ section.settings.featured_image_alt | default: section.settings.featured_label | escape }}"

            loading="lazy"

          >

        </div>

      {% else %}

        <div class="epf-story__featured-grid">

          {% for block in section.blocks %}

            {% if block.type == 'featured_logo' %}

              <span class="epf-story__logo-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>

            {% endif %}

          {% endfor %}

        </div>

      {% endif %}

    </div>



    <div class="epf-story__section epf-story__split">

      <div class="epf-story__content">

        <h2>{{ section.settings.problem_heading | replace: '[product_title]', product.title }}</h2>

        {% if section.settings.problem_body != blank %}

          <p>

            {{ section.settings.problem_body | replace: '[product_title]', product.title | newline_to_br }}

          </p>

        {% endif %}

        <div class="epf-story__note-list">

          {% for block in section.blocks %}

            {% if block.type == 'problem_note' %}

              <div class="epf-story__note" {{ block.shopify_attributes }}>

                {{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}

              </div>

            {% endif %}

          {% endfor %}

        </div>

      </div>



      <div class="epf-story__problem-card">

        <div class="epf-story__problem-card-inner">

          <div class="epf-story__card-media">

            {% if problem_image != blank %}

              {{

                problem_image

                | image_url: width: 780

                | image_tag:

                  loading: 'lazy',

                  widths: '320, 480, 640, 780',

                  sizes: '(min-width: 990px) 24vw, 90vw',

                  alt: product.title

              }}

            {% else %}

              {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}

            {% endif %}

          </div>

          <div class="epf-story__diagram">

            <div class="epf-story__diagram-bars">

              <div class="epf-story__bar">

                <div class="epf-story__bar-fill epf-story__bar-fill--rose"></div>

                <span>{{ section.settings.problem_bar_label_1 }}</span>

              </div>

              <div class="epf-story__bar">

                <div class="epf-story__bar-fill epf-story__bar-fill--sand"></div>

                <span>{{ section.settings.problem_bar_label_2 }}</span>

              </div>

              <div class="epf-story__bar">

                <div class="epf-story__bar-fill epf-story__bar-fill--sage"></div>

                <span>{{ section.settings.problem_bar_label_3 }}</span>

              </div>

            </div>

            <div class="epf-story__tendon-card">

              <strong>{{ section.settings.problem_tendon_heading | replace: '[product_title]', product.title }}</strong>

              {{ section.settings.problem_tendon_copy | replace: '[product_title]', product.title | newline_to_br }}

            </div>

          </div>

        </div>

      </div>

    </div>



    <div class="epf-story__section epf-story__split">

      <div class="epf-story__problem-card">

        <div class="epf-story__problem-card-inner">

          <div class="epf-story__card-media">

            {% if intro_image != blank %}

              {{

                intro_image

                | image_url: width: 780

                | image_tag:

                  loading: 'lazy',

                  widths: '320, 480, 640, 780',

                  sizes: '(min-width: 990px) 24vw, 90vw',

                  alt: product.title

              }}

            {% else %}

              {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}

            {% endif %}

          </div>

          <div class="epf-story__note-list">

            {% for block in section.blocks %}

              {% if block.type == 'intro_side_feature' %}

                <div class="epf-story__feature-card" {{ block.shopify_attributes }}>

                  <div class="epf-story__feature-pill">{{ block.settings.badge }}</div>

                  <h3>{{ block.settings.heading | replace: '[product_title]', product.title }}</h3>

                  <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>

                </div>

              {% endif %}

            {% endfor %}

          </div>

        </div>

      </div>



      <div class="epf-story__content">

        <h2>{{ section.settings.intro_heading | replace: '[product_title]', product.title }}</h2>

        {% if section.settings.intro_body != blank %}

          <p>

            {{ section.settings.intro_body | replace: '[product_title]', product.title | newline_to_br }}

          </p>

        {% endif %}

        <div class="epf-story__feature-grid">

          {% for block in section.blocks %}

            {% if block.type == 'intro_feature' %}

              <article class="epf-story__feature-card" {{ block.shopify_attributes }}>

                <div class="epf-story__feature-pill">{{ block.settings.badge }}</div>

                <h3>{{ block.settings.heading | replace: '[product_title]', product.title }}</h3>

                <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>

              </article>

            {% endif %}

          {% endfor %}

        </div>

      </div>

    </div>



    <div class="epf-story__section" id="epf-what-to-expect">

      <div class="epf-story__section-header">

        <h2>{{ section.settings.expect_heading | replace: '[product_title]', product.title }}</h2>

      </div>



      <div class="epf-story__expect-grid">

        {% assign expect_index = 0 %}

        {% for block in section.blocks %}

          {% if block.type == 'expect_card' %}

            {% assign expect_index = expect_index | plus: 1 %}

            {% assign expect_image = block.settings.image %}

            {% if expect_image == blank %}

              {% case expect_index %}

                {% when 1 %}

                  {% if expect_media_1 != blank %}{% assign expect_image = expect_media_1.preview_image %}{% endif %}

                {% when 2 %}

                  {% if expect_media_2 != blank %}{% assign expect_image = expect_media_2.preview_image %}{% endif %}

                {% when 3 %}

                  {% if expect_media_3 != blank %}{% assign expect_image = expect_media_3.preview_image %}{% endif %}

              {% endcase %}

            {% endif %}

            <article class="epf-story__card" {{ block.shopify_attributes }}>

              <div class="epf-story__card-media">

                {% if expect_image != blank %}

                  {{

                    expect_image

                    | image_url: width: 720

                    | image_tag:

                      loading: 'lazy',

                      widths: '260, 360, 540, 720',

                      sizes: '(min-width: 990px) 24vw, 90vw',

                      alt: block.settings.heading

                  }}

                {% else %}

                  {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}

                {% endif %}

              </div>

              <div class="epf-story__card-body">

                <p class="epf-story__step-kicker">{{ block.settings.kicker }}</p>

                <h3>{{ block.settings.heading | replace: '[product_title]', product.title }}</h3>

                <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>

              </div>

            </article>

          {% endif %}

        {% endfor %}

      </div>



      {% if section.settings.expect_cta_label != blank %}

        <div class="epf-story__expect-cta">

          <a class="epf-story__button epf-story__button--primary" href="{{ section.settings.expect_cta_link | default: '#MainProduct-offer_main' }}">

            {{ section.settings.expect_cta_label | replace: '[product_title]', product.title }}

          </a>

        </div>

      {% endif %}

    </div>



    <div class="epf-story__section">

      <div class="epf-story__results">

        <div class="epf-story__results-visual">

          {% if results_image != blank %}

            {{

              results_image

              | image_url: width: 900

              | image_tag:

                loading: 'lazy',

                widths: '320, 480, 640, 900',

                sizes: '(min-width: 990px) 28vw, 90vw',

                alt: product.title

            }}

          {% else %}

            {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}

          {% endif %}

          <div class="epf-story__results-glow"></div>

        </div>



        <div class="epf-story__content">

          <h2>{{ section.settings.results_heading | replace: '[product_title]', product.title }}</h2>

          {% if section.settings.results_body != blank %}

            <p>

              {{ section.settings.results_body | replace: '[product_title]', product.title | newline_to_br }}

            </p>

          {% endif %}



          <div class="epf-story__metric-list">

            {% for block in section.blocks %}

              {% if block.type == 'result_metric' %}

                <div class="epf-story__metric" {{ block.shopify_attributes }}>

                  <span class="epf-story__metric-icon">&#10003;</span>

                  <p class="epf-story__metric-copy">

                    {{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}

                  </p>

                </div>

              {% endif %}

            {% endfor %}

          </div>

        </div>

      </div>

    </div>



    <div class="epf-story__section">

      <div class="epf-story__section-header">

        <h2>{{ section.settings.journey_heading | replace: '[product_title]', product.title }}</h2>

      </div>



      <div class="epf-story__journey-grid">

        {% assign journey_index = 0 %}

        {% for block in section.blocks %}

          {% if block.type == 'journey_card' %}

            {% assign journey_index = journey_index | plus: 1 %}

            {% assign journey_image = block.settings.image %}

            {% if journey_image == blank %}

              {% case journey_index %}

                {% when 1 %}

                  {% if journey_media_1 != blank %}{% assign journey_image = journey_media_1.preview_image %}{% endif %}

                {% when 2 %}

                  {% if journey_media_2 != blank %}{% assign journey_image = journey_media_2.preview_image %}{% endif %}

                {% when 3 %}

                  {% if journey_media_3 != blank %}{% assign journey_image = journey_media_3.preview_image %}{% endif %}

              {% endcase %}

            {% endif %}

            <article class="epf-story__journey-card" {{ block.shopify_attributes }}>

              <div class="epf-story__journey-media">

                {% if journey_image != blank %}

                  {{

                    journey_image

                    | image_url: width: 720

                    | image_tag:

                      loading: 'lazy',

                      widths: '260, 360, 540, 720',

                      sizes: '(min-width: 990px) 24vw, 90vw',

                      alt: block.settings.heading

                  }}

                {% else %}

                  {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}

                {% endif %}

              </div>

              <div class="epf-story__journey-body">

                <p class="epf-story__journey-kicker">{{ block.settings.kicker }}</p>

                <h3>{{ block.settings.heading | replace: '[product_title]', product.title }}</h3>

                <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>

              </div>

            </article>

          {% endif %}

        {% endfor %}

      </div>



      {% if section.settings.journey_cta_label != blank %}

        <div class="epf-story__journey-cta">

          <a class="epf-story__button epf-story__button--secondary" href="{{ section.settings.journey_cta_link | default: '#epf-questions' }}">

            {{ section.settings.journey_cta_label | replace: '[product_title]', product.title }}

          </a>

        </div>

      {% endif %}

    </div>



    {% liquid
      assign has_testimonials = false
      assign has_support_points = false
      assign has_faq_items = false
      assign has_review_items = false

      for block in section.blocks
        case block.type
          when 'testimonial'
            assign has_testimonials = true
          when 'support_point'
            assign has_support_points = true
          when 'faq_item'
            assign has_faq_items = true
          when 'review_item'
            assign has_review_items = true
        endcase
      endfor
    %}

    {% if has_testimonials %}
      <div class="epf-story__section">

        <div class="epf-story__section-header">

          <h2>{{ section.settings.testimonials_heading | replace: '[product_title]', product.title }}</h2>

        </div>



        <div class="epf-story__voice-grid">

          {% assign testimonial_index = 0 %}

          {% for block in section.blocks %}

            {% if block.type == 'testimonial' %}

              {% assign testimonial_index = testimonial_index | plus: 1 %}

              {% assign testimonial_image = block.settings.image %}

              {% if testimonial_image == blank %}

                {% case testimonial_index %}

                  {% when 1 %}

                    {% if voice_media_1 != blank %}{% assign testimonial_image = voice_media_1.preview_image %}{% endif %}

                  {% when 2 %}

                    {% if voice_media_2 != blank %}{% assign testimonial_image = voice_media_2.preview_image %}{% endif %}

                  {% when 3 %}

                    {% if voice_media_3 != blank %}{% assign testimonial_image = voice_media_3.preview_image %}{% endif %}

                {% endcase %}

              {% endif %}

              <article class="epf-story__voice-card" {{ block.shopify_attributes }}>

                <div class="epf-story__voice-media">

                  {% if testimonial_image != blank %}

                    {{

                      testimonial_image

                      | image_url: width: 720

                      | image_tag:

                        loading: 'lazy',

                        widths: '260, 360, 540, 720',

                        sizes: '(min-width: 990px) 24vw, 90vw',

                        alt: block.settings.heading

                    }}

                  {% else %}

                    {{ 'image' | placeholder_svg_tag: 'epf-story__placeholder' }}

                  {% endif %}

                </div>

                <div class="epf-story__voice-body">

                  <div class="epf-story__voice-meta">{{ block.settings.meta | replace: '[product_title]', product.title }}</div>

                  <h3>{{ block.settings.heading | replace: '[product_title]', product.title }}</h3>

                  <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>

                </div>

              </article>

            {% endif %}

          {% endfor %}

        </div>

      </div>
    {% endif %}

    {% if has_support_points or has_faq_items or has_review_items %}
      <div class="epf-support__panel"{% if section.settings.section_anchor != blank %} id="{{ section.settings.section_anchor }}"{% endif %}>
        {% if has_support_points or has_faq_items %}
          <div class="epf-support__header epf-story__section-header">
            <h2>{{ section.settings.faq_heading | default: 'Questions Before You Start' | replace: '[product_title]', product.title }}</h2>
            {% if section.settings.faq_description != blank %}
              <p>{{ section.settings.faq_description | replace: '[product_title]', product.title }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if has_support_points %}
          <div class="epf-support__points">
            {% for block in section.blocks %}
              {% if block.type == 'support_point' %}
                <article class="epf-support__point" {{ block.shopify_attributes }}>
                  <div class="epf-support__point-icon">{{ block.settings.icon_text | default: '✓' }}</div>
                  <div>
                    <h3>{{ block.settings.title | replace: '[product_title]', product.title }}</h3>
                    <p>{{ block.settings.text | replace: '[product_title]', product.title }}</p>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if has_faq_items %}
          <div class="epf-support__faq">
            <div class="epf-support__faq-list">
              {% for block in section.blocks %}
                {% if block.type == 'faq_item' %}
                  <details class="epf-support__faq-item" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                    <summary>
                      <span>{{ block.settings.question | replace: '[product_title]', product.title }}</span>
                      <span class="epf-support__faq-toggle">+</span>
                    </summary>
                    <div class="epf-support__faq-answer">
                      <p>{{ block.settings.answer | replace: '[product_title]', product.title | newline_to_br }}</p>
                    </div>
                  </details>
                {% endif %}
              {% endfor %}
            </div>

            {% if section.settings.wellness_note != blank %}
              <p class="epf-support__wellness">{{ section.settings.wellness_note | replace: '[product_title]', product.title }}</p>
            {% endif %}
          </div>
        {% endif %}

        {% if has_review_items %}
          <div class="epf-support__reviews">
            <div class="epf-support__header epf-story__section-header">
              <h2>{{ section.settings.reviews_heading | default: section.settings.testimonials_heading | replace: '[product_title]', product.title }}</h2>
              {% if section.settings.reviews_description != blank %}
                <p>{{ section.settings.reviews_description | replace: '[product_title]', product.title }}</p>
              {% endif %}
            </div>

            <div class="epf-support__reviews-grid">
              {% for block in section.blocks %}
                {% if block.type == 'review_item' %}
                  <article class="epf-support__review-card" {{ block.shopify_attributes }}>
                    {% if block.settings.stars != blank %}
                      <div class="epf-support__review-stars">{{ block.settings.stars }}</div>
                    {% endif %}
                    {% if block.settings.meta != blank %}
                      <div class="epf-support__review-meta">{{ block.settings.meta | replace: '[product_title]', product.title }}</div>
                    {% endif %}
                    <h3>{{ block.settings.title | replace: '[product_title]', product.title }}</h3>
                    <p>{{ block.settings.text | replace: '[product_title]', product.title | newline_to_br }}</p>
                    {% if block.settings.author != blank %}
                      <div class="epf-support__review-author">{{ block.settings.author | replace: '[product_title]', product.title }}</div>
                    {% endif %}
                  </article>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>

</section>



