  "tag": "section",
  "class": "colic-guide-section",
  "settings": [
    {
      "type": "header",
      "content": "Masthead"
    },
    {
      "type": "text",
      "id": "site_name",
      "label": "Wordmark / site name",
      "default": "Hosfu Feeding Journal"
    },
    {
      "type": "text",
      "id": "site_tagline",
      "label": "Wordmark tagline",
      "default": "parent guide"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Colic & Comfort · Parent Guide"
    },
    {
      "type": "text",
