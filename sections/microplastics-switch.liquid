{{ 'section-microplastics-switch.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Mulish:wght@400;500;600;700;800&display=swap" rel="stylesheet">

{% liquid
  assign root_id = 'hf-adv-' | append: section.id

  assign hero_title = section.settings.hero_title
  if hero_title == blank and article.title != blank
    assign hero_title = article.title | escape
  endif

  assign hero_dek = section.settings.hero_dek
  if hero_dek == blank and article.excerpt != blank
    assign hero_dek = article.excerpt | strip_html
  endif

  assign product_link = section.settings.product_link | default: '/products/hosfu-glass-baby-bottle'
%}

<div class="hf-adv" id="{{ root_id }}">
  {% if section.settings.top_bar_text != blank %}
    <div class="topbar">{{ section.settings.top_bar_text }}</div>
  {% endif %}

  <div class="wrap">
    <header class="hero reveal">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ hero_title }}</h1>
      {% if hero_dek != blank %}<p class="dek">{{ hero_dek }}</p>{% endif %}
      <div class="byline">
        {% if section.settings.author_avatar != blank %}
          <div class="avatar"><img src="{{ section.settings.author_avatar }}" alt="Reviewer avatar" width="42" height="42" loading="lazy"></div>
        {% endif %}
        <div>{{ section.settings.byline_html }}</div>
      </div>
    </header>

    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'lede' %}
          <section class="lede reveal" {{ block.shopify_attributes }}>{{ block.settings.body }}</section>

        {% when 'source_box' %}
          <div class="source-box reveal" {{ block.shopify_attributes }}>{{ block.settings.body }}</div>

        {% when 'reason' %}
          <article class="reason reveal" {{ block.shopify_attributes }}>
            {% if block.settings.number != blank %}<div class="num">{{ block.settings.number }}</div>{% endif %}
            <h2>{{ block.settings.title }}</h2>
            {{ block.settings.body }}
          </article>
          {% if block.settings.image != blank %}
            <figure class="reason-media reveal">
              <img src="{{ block.settings.image }}" alt="{{ block.settings.image_alt | escape }}" width="1254" height="1254" loading="lazy">
            </figure>
          {% endif %}

        {% when 'cta' %}
          <section class="cta-strip reveal" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            <a class="cta" href="{{ block.settings.button_link | default: product_link }}">{{ block.settings.button_label | default: 'Shop now' }}</a>
            {% if block.settings.microcopy != blank %}<p class="microcopy">{{ block.settings.microcopy }}</p>{% endif %}
          </section>

        {% when 'proof_grid' %}
          <section class="proof-grid reveal" aria-label="Material highlights" {{ block.shopify_attributes }}>
            {% if block.settings.card1_title != blank %}<div class="proof-card"><b>{{ block.settings.card1_title }}</b><span>{{ block.settings.card1_text }}</span></div>{% endif %}
            {% if block.settings.card2_title != blank %}<div class="proof-card"><b>{{ block.settings.card2_title }}</b><span>{{ block.settings.card2_text }}</span></div>{% endif %}
            {% if block.settings.card3_title != blank %}<div class="proof-card"><b>{{ block.settings.card3_title }}</b><span>{{ block.settings.card3_text }}</span></div>{% endif %}
          </section>

        {% when 'comparison' %}
          <section class="compare reveal" {{ block.shopify_attributes }}>
            <table>
              <thead>
                <tr>
                  <th>&nbsp;</th>
                  <th class="hosfu">{{ block.settings.us_label }}</th>
                  <th>{{ block.settings.col_a_label }}</th>
                  <th>{{ block.settings.col_b_label }}</th>
                </tr>
              </thead>
              <tbody>
                {% for i in (1..6) %}
                  {% assign f = 'row' | append: i | append: '_feature' %}
                  {% assign u = 'row' | append: i | append: '_us' %}
                  {% assign a = 'row' | append: i | append: '_a' %}
                  {% assign b = 'row' | append: i | append: '_b' %}
                  {% assign feature = block.settings[f] %}
                  {% if feature != blank %}
                    {% assign us = block.settings[u] %}
                    {% assign ca = block.settings[a] %}
                    {% assign cb = block.settings[b] %}
                    <tr>
                      <td>{{ feature }}</td>
                      <td class="hosfu{% if us == '✓' %} yes{% endif %}">{{ us }}</td>
                      <td{% if ca == '✗' %} class="no"{% elsif ca == '✓' %} class="yes"{% endif %}>{{ ca }}</td>
                      <td{% if cb == '✗' %} class="no"{% elsif cb == '✓' %} class="yes"{% endif %}>{{ cb }}</td>
                    </tr>
                  {% endif %}
                {% endfor %}
              </tbody>
            </table>
          </section>

        {% when 'material_box' %}
          <section class="material-box reveal" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
            {% for i in (1..6) %}
              {% assign t = 'item' | append: i | append: '_title' %}
              {% assign x = 'item' | append: i | append: '_text' %}
              {% if block.settings[t] != blank %}
                <div class="material"><b>{{ block.settings[t] }}</b><span>{{ block.settings[x] }}</span></div>
              {% endif %}
            {% endfor %}
          </section>

        {% when 'truth_box' %}
          <section class="truth-box reveal" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
            <div class="cols">
              <div class="does">
                {% if block.settings.col1_heading != blank %}<h4>{{ block.settings.col1_heading }}</h4>{% endif %}
                <ul>
                  {% assign items1 = block.settings.col1_items | newline_to_br | split: '<br />' %}
                  {% for item in items1 %}{% assign line = item | strip %}{% if line != blank %}<li>{{ line }}</li>{% endif %}{% endfor %}
                </ul>
              </div>
              <div class="doesnt">
                {% if block.settings.col2_heading != blank %}<h4>{{ block.settings.col2_heading }}</h4>{% endif %}
                <ul>
                  {% assign items2 = block.settings.col2_items | newline_to_br | split: '<br />' %}
                  {% for item in items2 %}{% assign line = item | strip %}{% if line != blank %}<li>{{ line }}</li>{% endif %}{% endfor %}
                </ul>
              </div>
            </div>
          </section>

        {% when 'heading' %}
          <section class="block-heading reveal" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
            {% if block.settings.subtext != blank %}<p class="center-copy">{{ block.settings.subtext }}</p>{% endif %}
          </section>

        {% when 'note' %}
          <div class="note reveal" {{ block.shopify_attributes }}>
            {% if block.settings.show_stars %}<div class="stars">★★★★★</div>{% endif %}
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
          </div>

        {% when 'faq' %}
          <details class="reveal" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            {{ block.settings.answer }}
          </details>

        {% when 'close' %}
          <section class="close reveal" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            <a class="cta" href="{{ block.settings.button_link | default: product_link }}">{{ block.settings.button_label | default: 'Shop now' }}</a>
            {% if block.settings.microcopy != blank %}<p class="microcopy">{{ block.settings.microcopy }}</p>{% endif %}
          </section>

      {% endcase %}
    {% endfor %}

    {% if section.settings.footer_html != blank %}
      <footer class="foot">{{ section.settings.footer_html }}</footer>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('{{ root_id }}');
    if (!root) { return; }
    var els = root.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Microplastics Switch",
  "tag": "section",
  "class": "microplastics-switch-section",
  "max_blocks": 50,
  "settings": [
